    /* ==========================================================================
       How It Works & Industries We Support (New Executive Design)
       ========================================================================== */
    .how-it-works-section {
        background: #ffffff;
        padding: 85px 0 95px;
        position: relative;
    }

    .steps-flow-wrapper {
        margin-top: 45px;
    }

    .steps-flow-grid {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    .step-flow-item {
        flex: 1;
        min-width: 170px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
    }

    .step-bubble {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e11d48 0%, #A92036 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
        font-size: 1.45rem;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(169, 32, 54, 0.3);
        margin-bottom: 14px;
        transition: transform 0.3s ease;
    }

    .step-flow-item:hover .step-bubble {
        transform: scale(1.1) translateY(-3px);
    }

    .step-flow-box {
        background: #520713;
        border-radius: 12px;
        padding: 16px 14px;
        width: 100%;
        min-height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(82, 7, 19, 0.18);
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .step-flow-item:hover .step-flow-box {
        background: #801225;
        transform: translateY(-2px);
    }

    .step-title {
        font-family: 'Poppins', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        line-height: 1.35;
    }

    .step-chevron {
        color: #cbd5e1;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 50px;
    }

    .process-quote-strip {
        background: #520713;
        color: #ffffff;
        border-radius: 14px;
        padding: 18px 28px;
        margin-top: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(82, 7, 19, 0.2);
    }

    .process-quote-strip p {
        font-family: 'Poppins', sans-serif;
        font-size: 1.05rem;
        margin: 0;
        line-height: 1.5;
        color: #ffe4e8;
    }

    .process-quote-strip strong {
        color: #ffffff;
    }

    /* Industries Grid */
    .industries-sub-section {
        margin-top: 70px;
        padding-top: 50px;
        border-top: 1px solid #f1f5f9;
    }

    .industries-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 6px;
    }

    .industries-subtitle {
        font-size: 0.98rem;
        color: #64748b;
        margin-bottom: 0;
    }

    .industries-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-top: 30px;
    }

    .industry-badge-card {
        background: #520713;
        color: #ffffff;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        box-shadow: 0 6px 16px rgba(82, 7, 19, 0.15);
        transition: all 0.25s ease;
        text-align: center;
    }

    .industry-badge-card:hover {
        background: #801225;
        transform: translateY(-3px);
        box-shadow: 0 10px 22px rgba(128, 18, 37, 0.25);
    }

    .industry-badge-card i {
        color: #ffb3be;
        font-size: 1.1rem;
    }

    /* Responsive Adjustments */
    @media (max-width: 991px) {
        .challenges-approach-grid {
            grid-template-columns: 1fr;
        }

        .why-choose-wrapper {
            grid-template-columns: 1fr;

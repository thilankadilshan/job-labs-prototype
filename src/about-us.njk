        .steps-flow-grid {
            flex-direction: column;
            gap: 20px;
        }

        .step-flow-item {
            width: 100%;
        }

        .step-flow-box {
            min-height: auto;
            padding: 14px;
        }
    }

    /* ==========================================================================
       Career Support Section Styles - Job Labs Signature Red (#A92036)
       ========================================================================== */
    .career-support {
        padding: 85px 0 95px;
        background: linear-gradient(180deg, #ffffff 0%, #fff8f9 100%);
        position: relative;
        overflow: hidden;
    }

    .career-support .support-content {
        text-align: center;
        max-width: 860px;
        margin: 0 auto;
    }

    .career-support-text {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.05rem, 2.2vw, 1.25rem);
        line-height: 1.8;
        color: #334155;
        margin-bottom: 2.2rem;
    }

    .support-highlight {
        color: #A92036;
        font-weight: 700;
        background: rgba(169, 32, 54, 0.08);
        padding: 2px 10px;
        border-radius: 6px;
        border: 1px solid rgba(169, 32, 54, 0.18);
        display: inline-block;
        margin: 2px 2px;
    }

    /* Career Support Feature Badges */
    .career-hub-features {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 2rem 0 2.5rem;
    }

    .career-feature-pill {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px 16px;
        background: #ffffff;
        border: 1px solid #fecdd3;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(169, 32, 54, 0.05);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: center;
        gap: 10px;
    }

    .career-feature-pill:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px -4px rgba(169, 32, 54, 0.15);
        border-color: #A92036;
    }

    .career-feature-pill i {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: linear-gradient(135deg, #A92036 0%, #801225 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 4px 12px rgba(169, 32, 54, 0.25);
    }

    .career-feature-pill span {
        font-family: 'Poppins', sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        color: #0f172a;
    }

    /* Career Hub Image Container */
    .career-hub-image-wrap {
        width: 100%;
        max-width: 820px;
        margin: 2rem auto;
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        border: 1.5px solid #fecdd3;
        box-shadow: 0 18px 40px -10px rgba(169, 32, 54, 0.15), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
        background: #ffffff;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .career-hub-image-wrap:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 50px -10px rgba(169, 32, 54, 0.22);
    }

    .career-hub-image-wrap img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }

    /* Primary Button */
    .btn-about-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: linear-gradient(135deg, #A92036 0%, #801225 100%);
        color: #ffffff !important;
        font-family: 'Poppins', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        padding: 16px 36px;
        border-radius: 50px;
        text-decoration: none !important;
        box-shadow: 0 10px 25px -4px rgba(169, 32, 54, 0.35);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
    }

    .btn-about-primary:hover {
        background: linear-gradient(135deg, #c4263f 0%, #A92036 100%);
        transform: translateY(-2px);
        box-shadow: 0 14px 30px -4px rgba(169, 32, 54, 0.45);
        color: #ffffff !important;
    }

    .btn-about-primary:active {
        transform: translateY(1px);
    }

    /* Responsive Media Queries for Career Support */
    @media (max-width: 991px) {
        .career-hub-features {
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .career-support {
            padding: 70px 0 80px;
        }
    }

    @media (max-width: 768px) {
        .career-support {
            padding: 55px 0 65px;
        }

        .career-support-text {
            font-size: 1.05rem;
            line-height: 1.7;
            margin-bottom: 1.8rem;
        }

        .career-hub-features {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin: 1.8rem 0 2rem;
        }

        .career-feature-pill {
            padding: 16px 12px;
        }

        .career-feature-pill i {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .career-feature-pill span {
            font-size: 0.85rem;
        }

        .career-hub-image-wrap {
            border-radius: 14px;
            margin: 1.5rem auto;
        }

        .btn-about-primary {
            width: 100%;
            max-width: 400px;
            padding: 14px 24px;
            font-size: 0.98rem;
        }
    }

    @media (max-width: 480px) {
        .career-support {
            padding: 45px 0 55px;
        }

        .career-support-text {
            font-size: 0.98rem;
            line-height: 1.65;
            text-align: left;
        }

        .career-hub-features {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .career-feature-pill {
            padding: 14px 10px;
            border-radius: 12px;
        }

        .career-feature-pill i {
            width: 36px;
            height: 36px;
            font-size: 0.95rem;
        }

        .career-feature-pill span {
            font-size: 0.8rem;
        }

        .support-highlight {
            font-size: 0.88rem;
            padding: 2px 6px;
        }

        .career-hub-image-wrap {
            border-radius: 10px;
            margin: 1.2rem auto 2rem;
        }

        .btn-about-primary {
            width: 100%;
            padding: 14px 18px;
            font-size: 0.92rem;
        }
    }
</style>
{% endblock %}

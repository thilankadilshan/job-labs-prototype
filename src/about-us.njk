---
permalink: "/about-us/"
---
{% extends "layouts/master.njk" %}
{% block title %}About Job Labs | Recruitment & Job Solutions in Sri Lanka{% endblock %}
{% block description %}Learn about Job Labs, Sri Lanka’s modern recruitment and job search platform helping job seekers and employers connect through innovative solutions.{% endblock %}
{% block keywords %}about job labs, recruitment sri lanka, job portal sri lanka, hiring solutions, who we are, why choose us{% endblock %}
{% block og_title %}About Job Labs | Recruitment & Job Solutions in Sri Lanka{% endblock %}
{% block og_description %}Learn about Job Labs, Sri Lanka’s modern recruitment and job search platform helping job seekers and employers connect through innovative solutions.{% endblock %}
{% block styles %}
<style>
    /* ==========================================================================
       Job Labs RED Theme Styles (#A92036 Brand Red, #801225 Deep Crimson, #520713 Wine)
       ========================================================================== */

    /* Hero Section */
    .about-hero {
        position: relative;
        min-height: 54vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 95px 0 85px;
        overflow: hidden;
        background-color: #520713;
    }

    .about-hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    .about-hero-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 25%;
        filter: brightness(1) contrast(1.02);
        transform: scale(1.02);
        transition: transform 6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .about-hero:hover .about-hero-bg img {
        transform: scale(1.06);
    }

    /* Soft Translucent Red Tint - Keeps Image Clearly Visible */
    .about-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            rgba(45, 6, 12, 0.50) 0%,
            rgba(169, 32, 54, 0.32) 48%,
            rgba(20, 2, 5, 0.55) 100%
        );
        z-index: 2;
    }

    .about-hero .container {
        position: relative;
        z-index: 3;
    }

    .hero-content {
        text-align: center;
        color: #ffffff;
        max-width: 900px;
        margin: 0 auto;
    }

    .about-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 7px 22px;
        border-radius: 50px;
        margin-bottom: 1.25rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(8px);
    }

    .about-hero-badge i {
        color: #ffccd3;
        font-size: 0.85rem;
    }

    .hero-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2.4rem, 5vw, 3.8rem);
        font-weight: 800;
        margin-bottom: 1rem;
        color: #ffffff;
        line-height: 1.15;
        letter-spacing: -0.5px;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
    }

    .hero-title .brand-accent {
        color: #ffffff;
        position: relative;
        display: inline-block;
    }

    .hero-title .brand-accent::after {
        content: '';
        position: absolute;
        bottom: 4px;
        left: 0;
        width: 100%;
        height: 6px;
        background: #ffffff;
        border-radius: 3px;
        opacity: 0.9;
        z-index: -1;
    }

    .hero-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.45rem);
        color: #ffffff;
        margin-bottom: 1.25rem;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
    }

    .hero-description {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.98);
        max-width: 780px;
        margin: 0 auto 2rem;
        line-height: 1.75;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
    }

    .hero-description strong {
        color: #ffffff;
        font-weight: 700;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.6);
        padding-bottom: 2px;
    }

    .about-hero-chips {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 1rem;
    }

    .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.32);
        padding: 8px 18px;
        border-radius: 50px;
        color: #ffffff;
        font-size: 0.92rem;
        font-weight: 600;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
    }

    .hero-chip:hover {
        background: rgba(255, 255, 255, 0.26);
        border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-2px);
    }

    .hero-chip i {
        color: #A92036;
        font-size: 0.95rem;
        background: #ffffff;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Section Global Headers */
    .about-section {
        padding: 75px 0;
    }

    .section-header-center {
        text-align: center;
        max-width: 800px;
        margin: 0 auto 3rem;
    }

    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(169, 32, 54, 0.08);
        border: 1px solid rgba(169, 32, 54, 0.25);
        color: #A92036;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        padding: 6px 16px;
        border-radius: 50px;
        margin-bottom: 0.85rem;
    }

    .section-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 4vw, 2.65rem);
        font-weight: 700;
        color: #1e293b;
        letter-spacing: -0.5px;
        margin-bottom: 0.85rem;
    }

    .section-subtitle-text {
        font-size: 1.15rem;
        color: #64748b;
        line-height: 1.6;
        margin: 0 auto;
    }

    .title-line {
        display: block;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #A92036 0%, #801225 100%);
        margin: 1rem auto 0;
        border-radius: 4px;
    }

    /* ==========================================================================
       Redesigned Mission Section (Compact, No Image, Red Theme Card)
       ========================================================================== */
    .mission-section {
        padding: 55px 0;
        background: #ffffff;
    }

    .mission-wrapper {
        max-width: 960px;
        margin: 0 auto;
    }

    .mission-card {
        background: linear-gradient(135deg, #ffffff 0%, #fff8f8 100%);
        border: 1px solid #fecdd3;
        border-left: 6px solid #A92036;
        border-radius: 18px;
        padding: 2.75rem 3.25rem;
        box-shadow: 0 10px 30px -5px rgba(169, 32, 54, 0.08), 0 4px 10px -2px rgba(0, 0, 0, 0.03);
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .mission-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px -8px rgba(169, 32, 54, 0.14);
    }

    .mission-card::after {
        content: '\f10e';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        right: 25px;
        bottom: 10px;
        font-size: 6.5rem;
        color: rgba(169, 32, 54, 0.04);
        pointer-events: none;
        line-height: 1;
    }

    .mission-header-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #A92036;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1rem;
    }

    .mission-header-tag i {
        font-size: 0.9rem;
    }

    .mission-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.85rem;
        font-weight: 700;
        color: #A92036;
        margin-bottom: 1.25rem;
    }

    .mission-statement {
        font-size: 1.25rem;
        line-height: 1.85;
        color: #334155;
        margin-bottom: 2rem;
        position: relative;
        z-index: 2;
    }

    .mission-statement .brand-highlight {
        color: #A92036;
        font-weight: 700;
    }

    .mission-statement .focus-highlight {
        color: #801225;
        font-weight: 700;
    }

    .mission-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 1.5rem;
        border-top: 1px solid #fecdd3;
        position: relative;
        z-index: 2;
    }

    .mission-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #ffffff;
        border: 1px solid #fecdd3;
        padding: 8px 18px;
        border-radius: 50px;
        font-size: 0.92rem;
        font-weight: 600;
        color: #801225;
        box-shadow: 0 2px 6px rgba(169, 32, 54, 0.04);
    }

    .mission-pill i {
        color: #A92036;
        font-size: 0.95rem;
    }

    /* ==========================================================================
       Who We Are & Why Businesses Need Us Section
       ========================================================================== */
    .who-we-are-section {
        background: #ffffff;
        padding: 85px 0 90px;
        position: relative;
    }

    .section-intro-text {
        font-size: 1.15rem;
        color: #475569;
        max-width: 820px;
        margin: 0 auto 1.5rem;
        line-height: 1.75;
        text-align: center;
    }

    .challenges-approach-grid {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 32px;
        margin-top: 45px;
        align-items: stretch;
    }

    .problem-card {
        background: #fff8f8;
        border: 1px solid #fecdd3;
        border-radius: 20px;
        padding: 38px 32px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 25px -10px rgba(169, 32, 54, 0.08);
    }

    .solution-card {
        background: #ffffff;
        border: 1.5px solid #A92036;
        border-radius: 20px;
        padding: 38px 32px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 15px 35px -10px rgba(169, 32, 54, 0.14);
        position: relative;
    }

    .card-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 4px 12px;
        border-radius: 20px;
        width: fit-content;
        margin-bottom: 14px;
    }

    .tag-problem {
        background: #fee2e2;
        color: #991b1b;
    }

    .tag-solution {
        background: #A92036;
        color: #ffffff;
    }

    .card-heading {
        font-family: 'Poppins', sans-serif;
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 24px;
        line-height: 1.3;
    }

    .heading-problem {
        color: #991b1b;
    }

    .heading-solution {
        color: #0f172a;
    }

    .challenges-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .challenges-list li {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #ffe4e6;
    }

    .icon-cross {
        width: 28px;
        height: 28px;
        min-width: 28px;
        background: #fee2e2;
        color: #dc2626;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
    }

    .challenge-text {
        font-size: 0.98rem;
        color: #475569;
        font-weight: 600;
    }

    .solutions-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .solution-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 16px;
        background: #fff9fa;
        border-radius: 14px;
        border: 1px solid #ffe4e8;
        transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .solution-item:hover {
        transform: translateX(4px);
        border-color: #fecdd3;
    }

    .icon-check {
        width: 32px;
        height: 32px;
        min-width: 32px;
        background: #A92036;
        color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.88rem;
        box-shadow: 0 4px 10px rgba(169, 32, 54, 0.25);
    }

    .solution-content h4 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .solution-content p {
        font-size: 0.92rem;
        color: #475569;
        line-height: 1.5;
        margin-bottom: 0;
    }

    /* ==========================================================================
       Why Businesses Choose Job Labs Section
       ========================================================================== */
    .why-choose-section {
        background: #fbfcfd;
        padding: 85px 0 95px;
        border-top: 1px solid #f1f5f9;
        border-bottom: 1px solid #f1f5f9;
    }

    .why-choose-wrapper {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 36px;
        margin-top: 45px;
        align-items: center;
    }

    .why-points-column {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .why-point-card {
        background: #ffffff;
        border: 1px solid #f1f5f9;
        border-radius: 16px;
        padding: 20px 22px;
        display: flex;
        align-items: flex-start;
        gap: 18px;
        box-shadow: 0 6px 18px -6px rgba(15, 23, 42, 0.05);
        transition: all 0.3s ease;
    }

    .why-point-card:hover {
        transform: translateY(-3px);
        border-color: #fecdd3;
        box-shadow: 0 10px 25px -8px rgba(169, 32, 54, 0.12);
    }

    .point-number {
        width: 38px;
        height: 38px;
        min-width: 38px;
        background: #A92036;
        color: #ffffff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
        font-size: 1.15rem;
        font-weight: 800;
        box-shadow: 0 4px 10px rgba(169, 32, 54, 0.25);
    }

    .point-details h3 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .point-details p {
        font-size: 0.92rem;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 0;
    }

    /* The Platform, Live Mockup Window */
    .platform-window-card {
        background: #ffffff;
        border-radius: 18px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 20px 45px -15px rgba(15, 23, 42, 0.15);
        overflow: hidden;
    }

    .platform-window-header {
        background: #1e293b;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .window-dots {
        display: flex;
        gap: 6px;
    }

    .window-dots .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
    }

    .window-dots .dot.red { background: #ef4444; }
    .window-dots .dot.yellow { background: #f59e0b; }
    .window-dots .dot.green { background: #10b981; }

    .window-title {
        color: #f1f5f9;
        font-size: 0.84rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .live-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .live-dot {
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
        animation: pulseLive 2s infinite;
    }

    @keyframes pulseLive {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* ---------- Job Labs ATS dashboard preview (matches the real admin dashboard) ---------- */
    .platform-window-body.jl-ats-body { padding: 0; background: #f4f6fb; }
    .jl-ats { display: grid; grid-template-columns: 148px minmax(0, 1fr); font-family: 'Inter', sans-serif; min-height: 330px; }
    .jl-ats-side { background: #fff; border-right: 1px solid #e8ebf3; display: flex; flex-direction: column; }
    .jl-ats-logo { display: flex; align-items: center; gap: 6px; padding: 12px; border-bottom: 1px solid #eef0f6; }
    .jl-ats-logo img { width: 26px; height: 26px; object-fit: contain; }
    .jl-ats-logo span { font-weight: 700; color: #4338ca; font-size: 0.9rem; }
    .jl-ats-user { display: flex; align-items: center; gap: 7px; padding: 10px 12px; border-bottom: 1px solid #eef0f6; }
    .jl-ats-user strong { display: block; font-size: 0.68rem; color: #1e293b; line-height: 1.2; }
    .jl-ats-user small { display: block; font-size: 0.52rem; letter-spacing: .5px; color: #64748b; }
    .jl-ats-avatar { width: 24px; height: 24px; border-radius: 50%; background: #fde2e4; color: #A92036; display: grid; place-items: center; font-size: 0.6rem; position: relative; flex-shrink: 0; }
    .jl-ats-avatar::after { content: ''; position: absolute; right: -1px; bottom: -1px; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; border: 1.5px solid #fff; }
    .jl-ats-avatar.sm { width: 20px; height: 20px; }
    .jl-ats-menu { list-style: none; margin: 8px 0 0; padding: 0 6px; }
    .jl-ats-menu li { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 6px; font-size: 0.64rem; color: #475569; font-weight: 500; white-space: nowrap; }
    .jl-ats-menu li i { width: 12px; text-align: center; color: #64748b; font-size: 0.62rem; }
    .jl-ats-menu li.active { background: #4f46e5; color: #fff; font-weight: 600; }
    .jl-ats-menu li.active i { color: #fff; }
    .jl-ats-top { display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1px solid #e8ebf3; padding: 10px 14px; font-weight: 700; color: #1e293b; font-size: 0.82rem; }
    .jl-ats-top-user { display: inline-flex; align-items: center; gap: 10px; color: #64748b; font-size: 0.7rem; }
    .jl-ats-content { padding: 12px; }
    .jl-ats-banner { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: linear-gradient(120deg, #4f46e5 0%, #5b4fe0 60%, #4338ca 100%); color: #fff; border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; }
    .jl-ats-banner::after { content: ''; position: absolute; right: -30px; top: -40px; width: 120px; height: 120px; border-radius: 50%; background: rgba(255,255,255,.08); }
    .jl-ats-chip { display: inline-flex; align-items: center; gap: 4px; background: rgba(255,255,255,.18); font-size: 0.55rem; font-weight: 600; padding: 3px 8px; border-radius: 999px; }
    .jl-ats-banner h4 { color: #fff; font-size: 0.95rem; font-weight: 700; margin: 6px 0 3px; }
    .jl-ats-banner p { color: rgba(255,255,255,.85); font-size: 0.6rem; margin: 0; }
    .jl-ats-date { display: flex; align-items: center; gap: 6px; position: relative; z-index: 1; font-size: 1rem; }
    .jl-ats-date span { text-align: right; }
    .jl-ats-date strong { display: block; font-size: 0.62rem; white-space: nowrap; }
    .jl-ats-date small { display: block; font-size: 0.55rem; opacity: .85; }
    .jl-ats-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .jl-ats-stat { background: #fff; border: 1px solid #e8ebf3; border-left: 3px solid var(--c); border-radius: 8px; padding: 9px 8px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .jl-ats-ic { width: 20px; height: 20px; border-radius: 6px; background: var(--c); color: #fff; display: grid; place-items: center; font-size: 0.55rem; margin-bottom: 4px; }
    .jl-ats-stat strong { font-size: 0.95rem; font-weight: 700; color: #1e293b; line-height: 1.1; }
    .jl-ats-stat small { font-size: 0.52rem; color: #64748b; line-height: 1.25; }
    @media (max-width: 575px) {
        .jl-ats { grid-template-columns: 1fr; }
        .jl-ats-side { display: none; }
        .jl-ats-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .jl-ats-date { display: none; }
        .jl-ats-stat small { font-size: 0.6rem; }
    }

    .platform-window-body {
        padding: 20px;
        background: #f8fafc;
    }

    .ats-mockup-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .ats-brand-pill {
        font-size: 0.88rem;
        color: #1e293b;
    }

    .ats-header-search {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.78rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-grow: 1;
        max-width: 200px;
    }

    .ats-mock-btn {
        background: #A92036;
        color: #ffffff;
        border: none;
        padding: 6px 12px;
        font-size: 0.76rem;
        font-weight: 700;
        border-radius: 6px;
    }

    .ats-mockup-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 16px;
    }

    .ats-stat-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
    }


{% block scripts %}
<script>
// CV Builder JavaScript
let currentStep = 1;
let totalSteps = 5;
let workExperienceCount = 1;
let educationCount = 1;
let technicalSkills = [];
let softSkills = [];

// Initialize on DOM load
document.addEventListener('DOMContentLoaded', function() {
    loadFromLocalStorage();
    updateProgressBar();
    updateNavigation();
});

// Step Navigation
// function changeStep(direction) {
//     const currentStepElement = document.getElementById(`step-${currentStep}`);
    
//     if (direction === 1) {
//         // Validate current step before proceeding
//         if (!validateStep(currentStep)) {
//             return;
//         }
        
//         if (currentStep === 5) {
//             generatePreview();
//         }
//     }
    
//     // Hide current step
//     currentStepElement.classList.remove('active');
    
//     // Update current step
//     currentStep += direction;
    
//     // Show new step
//     const newStepElement = document.getElementById(`step-${currentStep}`);
//     newStepElement.classList.add('active');
    
//     // Update progress bar and navigation
//     updateProgressBar();
//     updateNavigation();
    
//     // Generate preview when reaching step 5
//     if (currentStep === 5) {
//         generatePreview();
//     }
    
//     // Scroll to top
//     window.scrollTo({ top: 0, behavior: 'smooth' });
// }

function changeStep(direction) {
    // guard currentStep element
    const currentStepElement = document.getElementById(`step-${currentStep}`);
    
    // compute target step first
    const targetStep = currentStep + direction;

    // If trying to go before first step, do nothing
    if (targetStep < 1) return;

    // If trying to go past the last step: treat as Finish
    if (targetStep > totalSteps) {
        // optional: validate last step before finishing
        if (!validateStep(currentStep)) return;
        return finishCV(); // don't attempt to show non-existing step
    }

    // If moving forward, validate the current step first
    if (direction === 1 && !validateStep(currentStep)) {
        return;
    }

    // hide current step (if exists)
    if (currentStepElement) {
        currentStepElement.classList.remove('active');
    }

    // update the number
    currentStep = targetStep;

    // show new step (guard in case element missing)
    const newStepElement = document.getElementById(`step-${currentStep}`);
    if (newStepElement) {
        newStepElement.classList.add('active');
    } else {
        console.warn('Step element not found for step:', currentStep);
    }

    // update UI
    updateProgressBar();
    updateNavigation();

    // generate preview if we reached preview step
    if (currentStep === 5) {
        generatePreview();
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function finishCV() {
    // validate the last step
    if (!validateStep(currentStep)) return;

    // generate the preview and show a friendly message
    generatePreview();
    showAlert('All done — preview generated. Use the Download buttons to export your CV.', 'success');

    // Optionally: auto-save to localStorage
    saveToLocalStorage();

    // You could also submit the form server-side if desired:
    // document.getElementById('cvForm').submit();
}

// Update progress bar
function updateProgressBar() {
    const steps = document.querySelectorAll('.progress-step');
    steps.forEach((step, index) => {
        const stepNumber = index + 1;
        step.classList.remove('active', 'completed');
        
        if (stepNumber < currentStep) {
            step.classList.add('completed');
        } else if (stepNumber === currentStep) {
            step.classList.add('active');
        }
    });
}

// Update navigation buttons
// function updateNavigation() {
//     const prevBtn = document.getElementById('prevBtn');
//     const nextBtn = document.getElementById('nextBtn');
    
//     prevBtn.style.display = currentStep === 1 ? 'none' : 'inline-block';
//     nextBtn.textContent = currentStep === totalSteps ? 'Finish' : 'Next';
// }

function updateNavigation() {
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    prevBtn.style.display = currentStep === 1 ? 'none' : 'inline-block';
    
    if (currentStep === totalSteps) {
        nextBtn.textContent = 'Finish';
        // override the inline onclick with a safe handler that calls finishCV
        nextBtn.onclick = function (e) {
            // call finish via the same flow as changeStep would
            finishCV();
        };
    } else {
        nextBtn.textContent = 'Next';
        nextBtn.onclick = function (e) {
            changeStep(1);
        };
    }
}

// Form validation
function validateStep(step) {
    const stepElement = document.getElementById(`step-${step}`);
    const requiredFields = stepElement.querySelectorAll('input[required], textarea[required]');
    let isValid = true;
    
    requiredFields.forEach(field => {
        field.classList.remove('error');
        if (!field.value.trim()) {
            field.classList.add('error');
            isValid = false;
        }
    });
    
    if (!isValid) {
        showAlert('Please fill in all required fields.', 'error');
    }
    
    return isValid;
}

// Work Experience Functions
function addWorkExperience() {
    const container = document.getElementById('work-experience-container');
    const newExperience = createWorkExperienceItem(workExperienceCount);
    container.insertAdjacentHTML('beforeend', newExperience);
    workExperienceCount++;
}

function createWorkExperienceItem(index) {
    return `
        <div class="experience-item" data-index="${index}">
            <div class="item-header">
                <h3>Experience #${index + 1}</h3>
                <button type="button" class="btn btn-remove" onclick="removeWorkExperience(${index})">Remove</button>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Job Title *</label>
                    <input type="text" name="work_experience[${index}][job_title]" required>
                </div>
                <div class="form-group">
                    <label>Company *</label>
                    <input type="text" name="work_experience[${index}][company]" required>
                </div>
                <div class="form-group">
                    <label>Start Date *</label>
                    <input type="month" name="work_experience[${index}][start_date]" required>
                </div>
                <div class="form-group">
                    <label>End Date</label>
                    <input type="month" name="work_experience[${index}][end_date]">
                    <div class="checkbox-group">
                        <input type="checkbox" id="current_job_${index}" onchange="toggleCurrentJob(${index})">
                        <label for="current_job_${index}">Currently working here</label>
                    </div>
                </div>
                <div class="form-group full-width">
                    <label>Job Description</label>
                    <textarea name="work_experience[${index}][description]" rows="4" placeholder="Describe your responsibilities and achievements..."></textarea>
                </div>
            </div>
        </div>
    `;
}

function removeWorkExperience(index) {
    const item = document.querySelector(`.experience-item[data-index="${index}"]`);
    if (item) {
        item.remove();
    }
}

function toggleCurrentJob(index) {
    const checkbox = document.getElementById(`current_job_${index}`);
    const endDateInput = document.querySelector(`input[name="work_experience[${index}][end_date]"]`);
    
    if (checkbox.checked) {
        endDateInput.value = '';
        endDateInput.disabled = true;
    } else {
        endDateInput.disabled = false;
    }
}

// Education Functions
function addEducation() {
    const container = document.getElementById('education-container');
    const newEducation = createEducationItem(educationCount);
    container.insertAdjacentHTML('beforeend', newEducation);
    educationCount++;
}

function createEducationItem(index) {
    return `
        <div class="education-item" data-index="${index}">
            <div class="item-header">
                <h3>Education #${index + 1}</h3>
                <button type="button" class="btn btn-remove" onclick="removeEducation(${index})">Remove</button>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Degree/Qualification *</label>
                    <input type="text" name="education[${index}][degree]" required>
                </div>
                <div class="form-group">
                    <label>Institution *</label>
                    <input type="text" name="education[${index}][institution]" required>
                </div>
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="month" name="education[${index}][start_date]">
                </div>
                <div class="form-group">
                    <label>End Date</label>
                    <input type="month" name="education[${index}][end_date]">
                </div>
                <div class="form-group full-width">
                    <label>Additional Details</label>
                    <textarea name="education[${index}][details]" rows="3" placeholder="GPA, honors, relevant coursework, etc."></textarea>
                </div>
            </div>
        </div>
    `;
}

function removeEducation(index) {
    const item = document.querySelector(`.education-item[data-index="${index}"]`);
    if (item) {
        item.remove();
    }
}

// Skills Functions
function addSkill(type) {
    const inputId = type === 'technical' ? 'technical-skill-input' : 'soft-skill-input';
    const input = document.getElementById(inputId);
    const skill = input.value.trim();
    
    if (!skill) return;
    
    const skillsArray = type === 'technical' ? technicalSkills : softSkills;
    
    if (skillsArray.includes(skill)) {
        showAlert('This skill has already been added.', 'error');
        return;
    }
    
    skillsArray.push(skill);
    input.value = '';
    
    renderSkills(type);
}

function removeSkill(type, skill) {
    const skillsArray = type === 'technical' ? technicalSkills : softSkills;
    const index = skillsArray.indexOf(skill);
    
    if (index > -1) {
        skillsArray.splice(index, 1);
        renderSkills(type);
    }
}

function renderSkills(type) {
    const containerId = type === 'technical' ? 'technical-skills-container' : 'soft-skills-container';
    const container = document.getElementById(containerId);
    const skillsArray = type === 'technical' ? technicalSkills : softSkills;
    
    container.innerHTML = '';
    
    skillsArray.forEach(skill => {
        const skillTag = document.createElement('div');
        skillTag.className = 'skill-tag';
        skillTag.innerHTML = `
            ${skill}
            <button type="button" class="remove-skill" onclick="removeSkill('${type}', '${skill}')">&times;</button>
        `;
        container.appendChild(skillTag);
    });
}

// Add event listeners for skill inputs
document.addEventListener('DOMContentLoaded', function() {
    const technicalInput = document.getElementById('technical-skill-input');
    const softInput = document.getElementById('soft-skill-input');
    
    if (technicalInput) {
        technicalInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addSkill('technical');
            }
        });
    }
    
    if (softInput) {
        softInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addSkill('soft');
            }
        });
    }
});

// Generate CV Preview
function generatePreview() {
    const formData = new FormData(document.getElementById('cvForm'));
    const cvData = {};
    
    // Convert FormData to object
    for (let [key, value] of formData.entries()) {
        setNestedProperty(cvData, key, value);
    }
    
    // Add skills arrays
    cvData.technical_skills = technicalSkills;
    cvData.soft_skills = softSkills;
    
    const previewContainer = document.getElementById('cv-preview');
    previewContainer.innerHTML = generateCVHTML(cvData);
}

// Generate CV HTML
function generateCVHTML(data) {
    let html = '<div class="cv-header">';
    
    // Personal Information
    if (data.personal_info) {
        html += `<div class="cv-name">${data.personal_info.full_name || 'Your Name'}</div>`;
        
        let contactInfo = [];
        if (data.personal_info.email) contactInfo.push(data.personal_info.email);
        if (data.personal_info.phone) contactInfo.push(data.personal_info.phone);
        if (data.personal_info.address) contactInfo.push(data.personal_info.address);
        if (data.personal_info.linkedin) contactInfo.push(`<a href="${data.personal_info.linkedin}" target="_blank">LinkedIn</a>`);
        if (data.personal_info.portfolio) contactInfo.push(`<a href="${data.personal_info.portfolio}" target="_blank">Portfolio</a>`);
        
        if (contactInfo.length > 0) {
            html += `<div class="cv-contact">${contactInfo.join(' | ')}</div>`;
        }
    }
    
    html += '</div>';
    
    // Professional Summary
    if (data.personal_info && data.personal_info.summary) {
        html += `
            <div class="cv-section">
                <div class="cv-section-title">Professional Summary</div>
                <div class="cv-description">${data.personal_info.summary}</div>
            </div>
        `;
    }
    
    // Work Experience
    if (data.work_experience && Object.keys(data.work_experience).length > 0) {
        html += '<div class="cv-section"><div class="cv-section-title">Work Experience</div>';
        
        Object.values(data.work_experience).forEach(work => {
            if (work.job_title && work.company) {
                const endDate = work.end_date || 'Present';
                html += `
                    <div class="cv-item">
                        <div class="cv-item-header">
                            <div>
                                <div class="cv-job-title">${work.job_title}</div>
                                <div class="cv-company">${work.company}</div>
                            </div>
                            <div class="cv-date">${work.start_date || 'Start Date'} - ${endDate}</div>
                        </div>
                        ${work.description ? `<div class="cv-description">${work.description}</div>` : ''}
                    </div>
                `;
            }
        });
        
        html += '</div>';
    }
    
    // Education
    if (data.education && Object.keys(data.education).length > 0) {
        html += '<div class="cv-section"><div class="cv-section-title">Education</div>';
        
        Object.values(data.education).forEach(edu => {
            if (edu.degree && edu.institution) {
                const endDate = edu.end_date || 'Present';
                html += `
                    <div class="cv-item">
                        <div class="cv-item-header">
                            <div>
                                <div class="cv-degree">${edu.degree}</div>
                                <div class="cv-institution">${edu.institution}</div>
                            </div>
                            <div class="cv-date">${edu.start_date || 'Start'} - ${endDate}</div>
                        </div>
                        ${edu.details ? `<div class="cv-description">${edu.details}</div>` : ''}
                    </div>
                `;
            }
        });
        
        html += '</div>';
    }
    
    // Achievements
    if (data.achievements) {
        html += `
            <div class="cv-section">
                <div class="cv-section-title">Achievements & Certifications</div>
                <div class="cv-description">${data.achievements.replace(/\n/g, '<br>')}</div>
            </div>
        `;
    }
    
    // Technical Skills
    if (data.technical_skills && data.technical_skills.length > 0) {
        html += `
            <div class="cv-section">
                <div class="cv-section-title">Technical Skills</div>
                <div class="cv-skills">
                    ${data.technical_skills.map(skill => `<span class="cv-skill">${skill}</span>`).join('')}
                </div>
            </div>
        `;
    }
    
    // Soft Skills
    if (data.soft_skills && data.soft_skills.length > 0) {
        html += `
            <div class="cv-section">
                <div class="cv-section-title">Soft Skills</div>
                <div class="cv-skills">
                    ${data.soft_skills.map(skill => `<span class="cv-skill">${skill}</span>`).join('')}
                </div>
            </div>
        `;
    }
    
    return html;
}

// Utility function to set nested properties
function setNestedProperty(obj, path, value) {
    const keys = path.replace(/\]/g, '').split(/[\[\.]/).filter(k => k);
    let current = obj;
    
    for (let i = 0; i < keys.length - 1; i++) {
        const key = keys[i];
        if (!(key in current)) {
            current[key] = {};
        }
        current = current[key];
    }
    
    current[keys[keys.length - 1]] = value;
}

// Local Storage Functions
function saveToLocalStorage() {
    const formData = new FormData(document.getElementById('cvForm'));
    const cvData = {};
    
    // Convert FormData to object
    for (let [key, value] of formData.entries()) {
        setNestedProperty(cvData, key, value);
    }
    
    // Add skills arrays
    cvData.technical_skills = technicalSkills;
    cvData.soft_skills = softSkills;
    
    // Save to localStorage
    localStorage.setItem('cvBuilderData', JSON.stringify(cvData));
    
    showAlert('CV data saved successfully!', 'success');
}

function loadFromLocalStorage() {
    const savedData = localStorage.getItem('cvBuilderData');
    
    if (!savedData) return;
    
    try {
        const cvData = JSON.parse(savedData);
        populateForm(cvData);
        
        // Load skills
        if (cvData.technical_skills) {
            technicalSkills = cvData.technical_skills;
            renderSkills('technical');
        }
        
        if (cvData.soft_skills) {
            softSkills = cvData.soft_skills;
            renderSkills('soft');
        }
        
    } catch (error) {
        console.error('Error loading saved CV data:', error);
    }
}

function populateForm(data) {
    // Populate personal information
    if (data.personal_info) {
        Object.keys(data.personal_info).forEach(key => {
            const field = document.querySelector(`input[name="personal_info[${key}]"], textarea[name="personal_info[${key}]"]`);
            if (field) {
                field.value = data.personal_info[key];
            }
        });
    }
    
    // Populate work experience
    if (data.work_experience) {
        const workContainer = document.getElementById('work-experience-container');
        workContainer.innerHTML = '';
        workExperienceCount = 0;
        
        Object.keys(data.work_experience).forEach(index => {
            const work = data.work_experience[index];
            addWorkExperience();
            
            Object.keys(work).forEach(key => {
                const field = document.querySelector(`input[name="work_experience[${index}][${key}]"], textarea[name="work_experience[${index}][${key}]"]`);
                if (field) {
                    field.value = work[key];
                }
            });
        });
    }
    
    // Populate education
    if (data.education) {
        const eduContainer = document.getElementById('education-container');
        eduContainer.innerHTML = '';
        educationCount = 0;
        
        Object.keys(data.education).forEach(index => {
            const edu = data.education[index];
            addEducation();
            
            Object.keys(edu).forEach(key => {
                const field = document.querySelector(`input[name="education[${index}][${key}]"], textarea[name="education[${index}][${key}]"]`);
                if (field) {
                    field.value = edu[key];
                }
            });
        });
    }
    
    // Populate achievements
    if (data.achievements) {
        const achievementsField = document.querySelector('textarea[name="achievements"]');
        if (achievementsField) {
            achievementsField.value = data.achievements;
        }
    }
}

// Download Functions
function downloadPDF() {
    const formData = new FormData(document.getElementById('cvForm'));
    
    // Add skills to form data
    technicalSkills.forEach((skill, index) => {
        formData.append(`technical_skills[${index}]`, skill);
    });
    
    softSkills.forEach((skill, index) => {
        formData.append(`soft_skills[${index}]`, skill);
    });
    
    // Show loading state
    const button = event.target;
    const originalText = button.textContent;
    button.innerHTML = '<span class="loading-spinner"></span> Generating PDF...';
    button.disabled = true;
    
    fetch('/cv-builder/generate-pdf', {
        method: 'POST',
        body: formData,
        headers: {
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        }
    })
    .then(response => {
        if (!response.ok) throw new Error('Failed to generate PDF');
        return response.blob();
    })
    .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.style.display = 'none';
        a.href = url;
        a.download = 'CV.pdf';
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        showAlert('PDF downloaded successfully!', 'success');
    })
    .catch(error => {
        console.error('Error:', error);
        showAlert('Error generating PDF. Please try again.', 'error');
    })
    .finally(() => {
        button.textContent = originalText;
        button.disabled = false;
    });
}


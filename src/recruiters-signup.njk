{% endblock %}
{% block scripts %}
<!-- Add jQuery CDN -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script type="text/javascript">
    function callbackThen(response) {
        console.log(response.status);
        response.json().then(function(data) {
            console.log(data);
        });
    }

    function callbackCatch(error) {
        console.error('Error:', error);
    }

    $(document).ready(function() {
        'use strict';

        // Set minimum datetime for preferred contact time
        const elem = document.getElementById("preftime");
        if (elem) {
            const now = new Date();
            // Format YYYY-MM-DDTHH:MM local time
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const localMinDate = `${year}-${month}-${day}T${hours}:${minutes}`;
            elem.value = localMinDate;
            elem.min = localMinDate;
        }

        // File upload enhancement with image preview
        const fileInput = document.getElementById('user_clogo');
        const fileUploadContainer = document.querySelector('.file-upload');
        const logoPreview = document.getElementById('logo-preview');
        const logoImage = document.getElementById('logo-image');
        const removeLogoBtn = document.getElementById('remove-logo');

        if (fileInput) {
            const fileLabel = fileInput.nextElementSibling ? fileInput.nextElementSibling.querySelector('span') : null;

            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];

                if (file) {
                    if (!file.type.startsWith('image/')) {
                        alert('Please select a valid image file');
                        fileInput.value = '';
                        return;
                    }

                    if (file.size > 2 * 1024 * 1024) {
                        alert('File size must be less than 2MB');
                        fileInput.value = '';
                        return;
                    }

                    if (fileLabel) {
                        fileLabel.textContent = file.name;
                        fileLabel.style.color = '#A92036';
                    }
                    if (fileUploadContainer) {
                        fileUploadContainer.classList.add('has-preview');
                    }

                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        if (logoImage) logoImage.src = evt.target.result;
                        if (logoPreview) logoPreview.style.display = 'inline-block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    resetFileUpload();
                }
            });

            if (removeLogoBtn) {
                removeLogoBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    fileInput.value = '';
                    resetFileUpload();
                });
            }

            function resetFileUpload() {
                if (fileLabel) {
                    fileLabel.textContent = 'Choose company logo or drag & drop here (Max 2MB)';
                    fileLabel.style.color = '';
                }
                if (logoPreview) logoPreview.style.display = 'none';
                if (logoImage) logoImage.src = '';
                if (fileUploadContainer) fileUploadContainer.classList.remove('has-preview');
            }
        }

        // Form validation
        const forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function(form) {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                // Safely verify reCAPTCHA only if active on page
                if (typeof grecaptcha !== 'undefined' && document.getElementById('captcha')) {
                    const response = grecaptcha.getResponse();
                    if (response === "") {
                        event.preventDefault();
                        event.stopPropagation();
                        document.getElementById('captcha').innerHTML = "Please complete the reCAPTCHA";
                        alert("You can't leave Captcha Code empty");
                    } else if (document.getElementById('captchas')) {
                        document.getElementById('captchas').innerHTML = "reCAPTCHA verified successfully!";
                    }
                }

                form.classList.add('was-validated');
            }, false);
        });

        // Phone number numbers-only validation
        $("#user_phone, #user_officeno").on('keypress', function(e) {
            const maxlengthNumber = parseInt($(this).attr('maxlength'));
            const inputValueLength = $(this).val().length + 1;

            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }

            if (maxlengthNumber < inputValueLength) {
                return false;
            }
        });
    });
</script>
{% endblock %}

{% block styles %}
<style>
    body {
        overflow-x: hidden !important;
    }

    /* floating-social styles with this updated version */
    .floating-social {
        position: fixed;
        right: -45px;
        /* Initially hidden */

        bottom: 100px;
        top: auto;
        transform: none;

        /* top: 50%; */
        /* transform: translateY(-50%); */
        z-index: 9999;
        transition: right 0.3s ease;
        overflow: hidden;
    }

    /* Show the container when hovered */
    .floating-social:hover {
        right: 20px;
    }

    /* Main toggle button */
    .floating-social::before {
        content: '';
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 50px;
        height: 50px;
        background: #080159;
        border-radius: 50%;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
        z-index: 10;
        cursor: pointer;
    }

    /* Add arrow icon to main button */
    .floating-social::after {
        content: '←';
        position: absolute;
        right: 17px;
        top: 50%;
        transform: translateY(-50%);
        color: white;
        font-size: 18px;
        font-weight: bold;
        z-index: 11;
        transition: transform 0.3s ease;
        pointer-events: none;
    }

    /* Rotate arrow on hover */
    .floating-social:hover::after {
        transform: translateY(-50%) rotate(180deg);
    }

    /* Container for social buttons */
    .floating-social .social-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
        opacity: 0;
        visibility: hidden;
        transform: translateX(20px);
        transition: all 0.3s ease;
        padding-right: 65px;
        /* Space for main button */
    }

    /* Show social buttons on hover */
    .floating-social:hover .social-buttons {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
    }

    /* Individual social media buttons */
    .floating-social a {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 20px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-md);
        position: relative;
        z-index: 5;
    }

    .floating-social a:hover {
        transform: scale(1.1);
        box-shadow: var(--shadow-lg);
    }

    /* Social media brand colors */
    .floating-social .facebook {
        background: #1877f2;
    }

    .floating-social .instagram {
        background: linear-gradient(45deg, #405de6, #5851db, #833ab4, #c13584, #e1306c, #fd1d1d);
    }

    .floating-social .whatsapp {
        background: #25d366;
    }

    .floating-social .linkedin {
        background: #0077b5;
    }

    /* Mobile responsiveness */
    @media (max-width: 768px) {
        .floating-social {
            right: -40px;
        }

        .floating-social:hover {
            right: 15px;
        }

        .floating-social::before {
            width: 45px;
            height: 45px;
        }

        .floating-social::after {
            right: 15px;
            font-size: 16px;
        }

        .floating-social .social-buttons {
            gap: 10px;
            padding-right: 60px;
        }

        .floating-social a {
            width: 45px;
            height: 45px;
            font-size: 18px;
        }

    }

    /* Optional: Add tooltip for main button */
    .floating-social .tooltip {
        position: absolute;
        right: 60px;
        top: 50%;
        transform: translateY(-50%) translateX(10px);
        background: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 12px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        pointer-events: none;
        overflow: hidden;

    }

    .floating-social:hover .tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(0);
    }

    /* Arrow for tooltip */
    .floating-social .tooltip::after {
        content: '';
        position: absolute;
        left: 100%;
        top: 50%;
        transform: translateY(-50%);
        border: 5px solid transparent;
        border-left-color: rgba(0, 0, 0, 0.8);
    }

    /* Landing page header customizations */
    .main-header {
        background-color: #e5e5ecff !important;
        border-bottom: none;
        padding-top: 11px;
    }
</style>

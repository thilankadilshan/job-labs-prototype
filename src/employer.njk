<style>
    @font-face {
        font-family: 'Neue Machina';
        src: url('/fonts/NeueMachina-Regular.otf') format('opentype');
        font-weight: 400;
        font-style: normal;
    }

    @font-face {
        font-family: 'Neue Machina';
        src: url('/fonts/NeueMachina-Bold.otf') format('opentype');
        font-weight: 700;
        font-style: normal;
    }

    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    /* -----------------------------------------
       ANIMATION KEYFRAMES
    ----------------------------------------- */
    @keyframes imageFadeInZoom {
        from {
            opacity: 0;
            transform: scale(1.1);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* -----------------------------------------
       BASE STYLES & FULL-WIDTH LAYOUT
    ----------------------------------------- */
    .hero-container-hm {
        font-family: 'Poppins', sans-serif;
        position: relative;
        width: 100%;
        min-height: 55vh; /* Reduced height as requested */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 5rem 2rem 3rem; /* Adjusted padding */
    }

    /* Full Width Background Image & Overlay */
    .hero-bg-hm {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        background-color: #1a1a1a;
    }

    .hero-bg-hm img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
    }

    .hero-bg-hm img.animate-img {
        animation: imageFadeInZoom 3s ease-out forwards;
    }

    .hero-overlay-hm {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.45) 100%);
        z-index: 2;
    }

    /* Content Wrapper */
    .hero-content-hm {
        position: relative;
        z-index: 3; /* Above the overlay */
        width: 100%;
        max-width: 1200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    /* Text Content */
    .hero-text-content-hm {
        width: 100%;
        max-width: 900px;
        color: #fff;
        opacity: 0;
    }

    .hero-text-content-hm.animate-text {
        opacity: 1;
        transition: opacity 0.1s;
    }

    .hero-text-content-hm h1 {
        display: none; /* Hide source text */
    }

    .animated-text-output {
        font-family: 'Neue Machina', sans-serif;
        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1.2;
        color: #fff;
        white-space: pre-wrap;
        margin-bottom: 1.2rem;
        text-shadow: 0 4px 12px rgba(0,0,0,0.4);
    }

    .hero-text-content-hm p {
        font-size: 1.25rem;
        font-weight: 400;
        color: #f0f0f0;
        opacity: 0;
        text-shadow: 0 2px 8px rgba(0,0,0,0.4);
    }

    .hero-text-content-hm p.animate-p {
        animation: fadeInUp 0.8s ease-out forwards;
        animation-delay: 1.2s;
    }

    /* Floating Bottom Bar - Now Transparent */
    .hero-bottom-bar-hm {
        background-color: transparent; /* Removed white background */
        width: 100%;
        max-width: 900px; /* Kept constrained so elements don't drift too far apart */
        margin-top: 3.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        opacity: 0;
    }

    .hero-bottom-bar-hm.animate-bottom {
        animation: fadeInUp 1s ease-out forwards;
        animation-delay: 1.8s;
    }

    /* Stats inside the transparent bar */
    .stats-wrapper-hm {
        display: flex;
        gap: 2.5rem;
        align-items: center;
    }

    .stat-box-hm {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .stat-box-hm i {
        font-size: 1.4rem;
        color: #A92036; /* Brand red for icons */
        text-shadow: 0 2px 4px rgba(0,0,0,0.5); /* Drop shadow for visibility */
    }

    .stat-box-hm span {
        font-size: 1.2rem;
        font-weight: 600;
        color: #fff; /* Changed to white */
        text-shadow: 0 2px 4px rgba(0,0,0,0.5); /* Drop shadow to pop off the image */
    }

    /* Call to Action Button */
    .collaborate-btn-hm {
        background-color: #A92036; 
        color: #fff;
        padding: 0.9rem 2.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 12px rgba(169, 32, 54, 0.4);
    }

    .collaborate-btn-hm:hover {
        background-color: #8f2626;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(169, 32, 54, 0.6);
    }

    /* Responsive Design */
    @media (max-width: 992px) {
        .animated-text-output {
            font-size: 2.8rem;
        }
        .hero-bottom-bar-hm {
            flex-direction: column;
            gap: 2rem;
            justify-content: center;
        }
        .stats-wrapper-hm {
            width: 100%;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }
    }

    @media (max-width: 576px) {
        .hero-container-hm {
            padding: 4rem 1rem 2rem;
            min-height: 60vh; /* Controlled mobile height */
        }
        .animated-text-output {
            font-size: 2rem;
        }
        .hero-text-content-hm p {
            font-size: 1rem;
        }
        .stats-wrapper-hm {
            gap: 1.5rem;
        }
        .stat-box-hm span {
            font-size: 1.1rem;
        }
        .collaborate-btn-hm {
            width: 100%;
            text-align: center;
        }
    }
</style>


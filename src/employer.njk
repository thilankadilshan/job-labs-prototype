{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Smooth scrolling for all anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    const headerHeight = document.querySelector('.main-header').offsetHeight;
                    const targetPosition = target.offsetTop - headerHeight - 20;

                    window.scrollTo({
                        top: targetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Enhanced floating social media functionality
        let socialTimeout;
        const floatingSocial = document.querySelector('.floating-social');

        // Show on hover
        floatingSocial.addEventListener('mouseenter', function() {
            clearTimeout(socialTimeout);
            this.style.right = '20px';
        });

        // Hide after delay when mouse leaves
        floatingSocial.addEventListener('mouseleave', function() {
            socialTimeout = setTimeout(() => {
                this.style.right = '-45px';
            }, 1000); // 1 second delay before hiding
        });

        // Enhanced scroll behavior for floating social
        let lastScrollTop = 0;
        let isScrolling = false;

        window.addEventListener('scroll', function() {
            if (!isScrolling) {
                window.requestAnimationFrame(function() {
                    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    const floatingSocial = document.querySelector('.floating-social');

                    if (scrollTop > lastScrollTop && scrollTop > 100) {
                        // Scrolling down - hide completely
                        floatingSocial.style.right = '-60px';
                    } else if (scrollTop < lastScrollTop) {
                        // Scrolling up - show peek
                        floatingSocial.style.right = '-45px';
                    }

                    // Show fully when near top
                    if (scrollTop < 50) {
                        floatingSocial.style.right = '-45px';
                    }

                    lastScrollTop = scrollTop;
                    isScrolling = false;
                });
            }
            isScrolling = true;
        }, {
            passive: true
        });

        // Add touch support for mobile devices
        if ('ontouchstart' in window) {
            floatingSocial.addEventListener('touchstart', function(e) {
                e.preventDefault();
                if (this.style.right === '20px' || this.style.right === '') {
                    this.style.right = '-45px';
                } else {
                    this.style.right = '20px';
                }
            });
        }

        // Optional: Add click to expand/collapse for accessibility
        floatingSocial.addEventListener('click', function(e) {
            // Only trigger if clicking on the main button area (not social links)
            if (e.target === this || e.target.classList.contains('tooltip')) {
                if (this.style.right === '20px') {
                    this.style.right = '-45px';
                } else {
                    this.style.right = '20px';
                }
            }
        });

        // Keyboard accessibility
        floatingSocial.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                if (this.style.right === '20px') {
                    this.style.right = '-45px';
                } else {
                    this.style.right = '20px';
                    // Focus first social link for keyboard navigation
                    setTimeout(() => {
                        this.querySelector('a').focus();
                    }, 300);
                }
            }
        });

        // Make the floating social focusable for keyboard users
        floatingSocial.setAttribute('tabindex', '0');
        floatingSocial.setAttribute('role', 'button');
        floatingSocial.setAttribute('aria-label', 'Social media links');

        // ##########################################

        // Auto-open modal on first visit (optional)
        const modalShown = localStorage.getItem('jobModalShown');
        if (!modalShown) {
            setTimeout(function() {
                openJobModal();
                localStorage.setItem('jobModalShown', 'true');
            }, 3000);
        }

        // Intersection Observer for scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-fade-up');
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe elements for animation
        document.querySelectorAll('.animate-on-scroll').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px)';
            el.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
            observer.observe(el);
        });

        // Performance optimization - lazy load images
        const imageObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    if (img.dataset.src) {
                        img.src = img.dataset.src;
                        img.classList.remove('lazy');
                        imageObserver.unobserve(img);
                    }
                }
            });
        });

        document.querySelectorAll('img[data-src]').forEach(img => {
            imageObserver.observe(img);
        });

        // Error handling for images
        document.querySelectorAll('img').forEach(img => {
            img.addEventListener('error', function() {
                this.style.opacity = '0.5';
                console.warn('Image failed to load:', this.src);
            });
        });
    });

    // Global functions for modal
    window.openJobModal = function() {
        const modal = document.getElementById('jobModal');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Focus management for accessibility
        modal.querySelector('.modal-close').focus();
    };

    window.closeJobModal = function() {
        const modal = document.getElementById('jobModal');
        modal.classList.remove('active');
        document.body.style.overflow = 'auto';
    };


</script>
{% endblock %}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const heroImage = document.getElementById('hero-image-hm');
        const headlineSource = document.getElementById('headline-source-text');
        const animatedTextContainer = document.getElementById('animated-text-container');
        const animatedParagraph = document.getElementById('animated-paragraph');
        const heroTextContent = document.getElementById('hero-text-content-hm');
        const bottomBar = document.getElementById('hero-bottom-bar-hm');

        const textToAnimate = headlineSource.textContent.trim();

        // Trigger animations
        heroImage.classList.add('animate-img');
        heroTextContent.classList.add('animate-text');
        animatedParagraph.classList.add('animate-p');
        bottomBar.classList.add('animate-bottom');

        // Headline animation (randomized reveal)
        function animateHeadline() {
            // Split the text into WORDS, not characters.
            const words = textToAnimate.split(' ');

            animatedTextContainer.innerHTML = words.map(word => {
                // Create a container for each word to keep its characters together.
                const charSpans = word.split('').map(char =>
                    `<span style="opacity:0; filter:blur(4px); transition:opacity 0.15s, filter 0.15s; display:inline-block;">${char}</span>`
                ).join('');
                return `<span style="display: inline-block; margin-right: 0.3em;">${charSpans}</span>`;
            }).join(''); 

            const charSpans = animatedTextContainer.querySelectorAll('span span');
            const totalChars = charSpans.length;
            const charsVisible = new Array(totalChars).fill(false);

            const interval = setInterval(() => {
                const hiddenIndices = charsVisible
                    .map((visible, i) => visible ? -1 : i)
                    .filter(i => i !== -1);

                if (hiddenIndices.length === 0) {
                    clearInterval(interval);
                    return;
                }

                const randomIndex = hiddenIndices[Math.floor(Math.random() * hiddenIndices.length)];
                if (charSpans[randomIndex]) {
                    charSpans[randomIndex].style.opacity = 1;
                    charSpans[randomIndex].style.filter = 'blur(0)';
                    charsVisible[randomIndex] = true;
                }
            }, 30); 
        }

        // Start headline animation immediately
        animateHeadline();
    });
</script>




<script>
document.addEventListener('DOMContentLoaded', function() {
    const sectorsSlider = document.getElementById('sectorsSlider');
    const sectorCards = document.querySelectorAll('.sector-card');
    const navDots = document.querySelectorAll('.nav-dot');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const currentSectorLabel = document.getElementById('currentSector');
    const sectorCounter = document.getElementById('sectorCounter');
    
    let currentSector = 0;
    let isAnimating = false;
    let autoRotateInterval;
    
    const sectorNames = [
        'Professional & Corporate',
        'Service & Hospitality',
        'Skilled Trades & Industrial'
    ];

    function updateSector(newIndex, animate = true) {
        if (isAnimating || newIndex === currentSector) return;
        
        if (animate) {
            isAnimating = true;
            setTimeout(() => { isAnimating = false; }, 600);
        }

        currentSector = newIndex;

        // Calculate transform based on screen size
        const isMobile = window.innerWidth <= 768;
        let translateX;
        
        if (isMobile) {
            // Mobile: show 1 card at a time
            translateX = -(currentSector * 100);
        } else {
            // Desktop: show 2 cards at a time
            if (currentSector === 0) translateX = 0;
            else if (currentSector === 1) translateX = -33.333;
            else translateX = -66.666;
        }
        
        sectorsSlider.style.transform = `translateX(${translateX}%)`;

        // Update active states
        sectorCards.forEach((card, index) => {
            card.classList.toggle('active', index === currentSector);
        });
        
        navDots.forEach((dot, index) => {
            dot.classList.toggle('active', index === currentSector);
        });

        // Update navigation info
        currentSectorLabel.textContent = sectorNames[currentSector];
        sectorCounter.textContent = `${currentSector + 1} / ${sectorCards.length}`;

        // Update button states
        prevBtn.disabled = currentSector === 0;
        nextBtn.disabled = currentSector === sectorCards.length - 1;
    }

    // Auto-rotation function
    // function startAutoRotate() {
    //     autoRotateInterval = setInterval(() => {
    //         const nextIndex = currentSector === sectorCards.length - 1 ? 0 : currentSector + 1;
    //         updateSector(nextIndex);
    //     }, 4000); // Rotate every 4 seconds
    // }

    // function stopAutoRotate() {
    //     clearInterval(autoRotateInterval);
    // }

    // function restartAutoRotate() {
    //     stopAutoRotate();
    //     setTimeout(startAutoRotate, 1000); // Restart after 1 second
    // }

    // Sector card click handlers
    sectorCards.forEach((card, index) => {
        card.addEventListener('click', () => {
            updateSector(index);
            restartAutoRotate(); // Restart auto-rotation after manual interaction
        });
    });

    // Navigation dot click handlers
    navDots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
            updateSector(index);
            restartAutoRotate();
        });
    });

    // Navigation button handlers
    prevBtn.addEventListener('click', () => {
        if (currentSector > 0) {
            updateSector(currentSector - 1);
            restartAutoRotate();
        }
    });

    nextBtn.addEventListener('click', () => {
        if (currentSector < sectorCards.length - 1) {
            updateSector(currentSector + 1);
            restartAutoRotate();
        }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && currentSector > 0) {
            updateSector(currentSector - 1);
            restartAutoRotate();
        } else if (e.key === 'ArrowRight' && currentSector < sectorCards.length - 1) {
            updateSector(currentSector + 1);
            restartAutoRotate();
        }
    });

    // Pause auto-rotate on hover
    const sectorsContainer = document.querySelector('.sectors-container');
    sectorsContainer.addEventListener('mouseenter', stopAutoRotate);
    sectorsContainer.addEventListener('mouseleave', startAutoRotate);

    // Handle window resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
            updateSector(currentSector, false); // Update without animation
        }, 250);
    });

    // Intersection Observer for animations (keep existing code)
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.animationDelay = '0.2s';
                entry.target.classList.add('slide-up');
            }
        });
    }, observerOptions);

    // Observe sector cards for staggered animation
    sectorCards.forEach((card, index) => {
        card.style.animationDelay = `${index * 0.1}s`;
        observer.observe(card);
    });

    // Initialize
    updateSector(0, false);
    startAutoRotate(); // Start auto-rotation
});
</script>


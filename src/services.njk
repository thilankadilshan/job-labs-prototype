        width: 100%;
        max-width: 130px;
        padding: 6px 10px;
        font-size: 0.78rem;
        font-weight: 700;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.25s ease;
        text-align: center;
    }

    .btn-plan-outline {
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #cbd5e1;
    }

    .btn-plan-outline:hover {
        background: #A92036;
        color: #ffffff;
        border-color: #A92036;
        text-decoration: none;
    }

    .btn-plan-primary {
        background: #A92036;
        color: #ffffff;
        border: 1px solid #A92036;
        box-shadow: 0 3px 10px rgba(169, 32, 54, 0.3);
    }

    .btn-plan-primary:hover {
        background: #801225;
        border-color: #801225;
        color: #ffffff;
        text-decoration: none;
    }

    /* Table Body */
    .pricing-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.15s ease;
    }

    .pricing-table tbody tr:nth-child(even) td:not(.col-popular) {
        background-color: #fafbfc;
    }

    .pricing-table tbody tr:hover td:not(.col-popular) {
        background-color: #f1f5f9;
    }

    .pricing-table tbody td {
        padding: 11px 12px;
        color: #334155;
    }

    .highlight-val {
        color: #A92036;
        font-weight: 700;
    }

    .check-yes {

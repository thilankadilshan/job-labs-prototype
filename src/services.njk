<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tableWrapper = document.getElementById('pricingTableResponsive');
        const tabBtns = document.querySelectorAll('.plan-tab-btn');

        if (tableWrapper && tabBtns.length > 0) {
            tabBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    tabBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const planKey = this.getAttribute('data-target');
                    const targetTh = tableWrapper.querySelector(`th[data-plan="${planKey}"]`);
                    const stickyTh = tableWrapper.querySelector('.col-feature-title');

                    if (targetTh) {
                        const stickyWidth = stickyTh ? stickyTh.offsetWidth : 140;
                        const scrollLeftPos = targetTh.offsetLeft - stickyWidth - 6;
                        tableWrapper.scrollTo({
                            left: Math.max(0, scrollLeftPos),
                            behavior: 'smooth'
                        });
                    }
                });
            });

            // Sync active tab on scroll
            let scrollTimeout;
            tableWrapper.addEventListener('scroll', function() {
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    const stickyTh = tableWrapper.querySelector('.col-feature-title');
                    const stickyWidth = stickyTh ? stickyTh.offsetWidth : 140;
                    const currentScroll = tableWrapper.scrollLeft + stickyWidth + 30;

                    const allThs = Array.from(tableWrapper.querySelectorAll('th[data-plan]'));
                    for (let i = allThs.length - 1; i >= 0; i--) {
                        if (currentScroll >= allThs[i].offsetLeft) {
                            const planKey = allThs[i].getAttribute('data-plan');
                            tabBtns.forEach(b => {
                                if (b.getAttribute('data-target') === planKey) {
                                    b.classList.add('active');
                                } else {
                                    b.classList.remove('active');
                                }
                            });
                            break;
                        }
                    }
                }, 100);
            }, { passive: true });
        }
    });
</script>



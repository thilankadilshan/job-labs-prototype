        align-items: center;
        gap: 5px;
        color: #A92036;
        font-weight: 600;
        font-size: 0.84rem;
    }

    .check-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #A92036;
        font-size: 0.95rem;
    }

    .highlight-check {
        color: #A92036;
        font-weight: 900;
    }

    .dash {
        color: #cbd5e1;
        font-size: 1.1rem;
    }

    .badge-unlimited {
        display: inline-block;
        background: #dcfce7;
        color: #166534;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        border: 1px solid #86efac;
    }

    /* Footer Note */
    .pricing-table-footer {
        padding: 14px 20px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .footer-conditions-note {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 0;
        line-height: 1.5;
    }

    /* 14-Day Free Trial Strip */
    .pricing-trial-strip {
        margin-top: 24px;
        background: #ffffff;
        border: 1px solid #fecdd3;
        border-radius: 12px;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        box-shadow: 0 4px 15px rgba(169, 32, 54, 0.05);
    }

    .trial-strip-text {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.92rem;
        color: #334155;

        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        padding: 5px 16px;
        border-radius: 50px;
        margin-bottom: 0.8rem;
    }

    .pricing-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 3.5vw, 2.7rem);
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 0.6rem;
        line-height: 1.2;
    }

    .pricing-subtitle {
        font-size: 1.05rem;
        color: #64748b;
        margin-bottom: 0;
        line-height: 1.5;
    }

    /* Table Container Card */
        /* Table Container Card */
    .pricing-table-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.06);
        position: relative;
    }

    .table-responsive {
        display: block !important;
        width: 100% !important;
        overflow-x: auto !important;
        overflow-y: hidden !important;
        -webkit-overflow-scrolling: touch !important;
        touch-action: pan-x pan-y !important;
        position: relative !important;
    }

    .pricing-table {
        width: 100%;
        min-width: 820px;
        border-collapse: collapse;
        font-family: 'Inter', sans-serif;
        font-size: 0.92rem;
    }

    /* Table Header */
    .pricing-table thead th {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 20px 14px 16px;
        vertical-align: top;
    }

    .col-feature-title {
        width: 30%;
        min-width: 240px;
        text-align: left;
        padding: 12px 20px !important;
        font-weight: 600;
        color: #1e293b;
    }

    .col-feature-title .header-label {
        font-family: 'Poppins', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
    }

    .col-plan {
        width: 14%;
        min-width: 124px;
        text-align: center;
        padding: 12px 10px;
        vertical-align: middle;
    }

    .plan-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .plan-name {
        font-family: 'Poppins', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 2px;
    }

    .plan-price {
        font-family: 'Poppins', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.3px;
        white-space: nowrap;
    }

    .plan-price .period {
        font-size: 0.8rem;
        font-weight: 500;
        color: #64748b;
    }

    .plan-type {
        font-size: 0.72rem;
        color: #64748b;
        background: #f1f5f9;
        padding: 2px 8px;
        border-radius: 20px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .plan-type-popular {
        background: #fee2e2;
        color: #991b1b;
    }

    /* Popular Column Highlight */
    .col-popular {
        background-color: #fff9fa !important;
        position: relative;
    }

    .pricing-table thead th.col-popular {
        background-color: #fff1f3 !important;
        border-top: 3px solid #A92036;
        border-left: 1px solid #fecdd3;
        border-right: 1px solid #fecdd3;
    }

    .pricing-table tbody td.col-popular {
        border-left: 1px solid #fecdd3;
        border-right: 1px solid #fecdd3;
        background-color: #fff9fa;
    }

    .popular-pill {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        background: #A92036;
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.8px;
        padding: 3px 6px;
        text-align: center;
    }

    /* Buttons */
    .btn-plan {

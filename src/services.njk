    .animate-on-scroll.animate-fade-up {
        opacity: 1;
        transform: translateY(0);
    }

    .stagger-1 {
        transition-delay: 0.1s;
    }

    .stagger-2 {
        transition-delay: 0.2s;
    }

    .stagger-3 {
        transition-delay: 0.3s;
    }

    .stagger-4 {

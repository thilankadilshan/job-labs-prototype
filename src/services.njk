    .trial-tag {
        background: #A92036;
        color: #ffffff;
        font-size: 0.74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .btn-trial-strip {
        background: #16a34a;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 8px 18px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        transition: all 0.25s ease;
    }

    .btn-trial-strip:hover {
        background: #15803d;
        color: #ffffff;
        text-decoration: none;
    }

    @media (max-width: 768px) {
        .pricing-matrix-section {
            padding: 55px 0 65px;
        }

        .pricing-trial-strip {
            flex-direction: column;
            text-align: center;
            gap: 12px;
        }

        .trial-strip-text {
            justify-content: center;
        }

        .btn-trial-strip {
            width: 100%;
            justify-content: center;
        }
    }
</style>

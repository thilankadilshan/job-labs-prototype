---
pagination:
  data: companyPages
  size: 1
  alias: entry
permalink: "/company/{{ entry.company.company_id }}/{{ entry.company.slug }}/"
---
{% extends "layouts/master.njk" %}
{# Mirrors JobsBoardController@companyProfile + the @php block of company-profile.blade.php #}
{% set company = entry.company %}
{% set jobs = entry.jobs %}
{% set stats = entry.stats %}
{% set companyName = company.company_name %}
{% set initial = (companyName | trim)[0] | upper %}
{% set overview = (company.company_overview or '') | trim %}
{% set isLongAbout = overview | length > 600 %}
{% set shareUrl = site.url ~ page.url ~ '#open-jobs' %}{# shared links open straight at the Open Jobs section #}
{% set shareText = 'Explore jobs at ' ~ companyName ~ ' on Job Labs' %}
{% block title %}{{ company.company_name ~ ' - Jobs & Company Profile | Job Labs' }}{% endblock %}
{% block og_title %}{{ company.company_name ~ ' - Jobs & Company Profile | Job Labs' }}{% endblock %}
{% block description %}{{ (overview | plainText | limitStr(160)) if overview else ('Explore open jobs at ' ~ companyName ~ ' in Sri Lanka on Job Labs.') }}{% endblock %}
{% block og_description %}{{ (overview | plainText | limitStr(160)) if overview else ('Explore open jobs at ' ~ companyName ~ ' in Sri Lanka on Job Labs.') }}{% endblock %}
{% block og_image %}{{ ('/upload/' ~ company.company_logo) if company.company_logo else '/assets/front/images/hr/job_logo.png' }}{% endblock %}
{% block styles %}
<style>
    /* Page-scoped theme (matches site: red #790D16 + navy #1F2A33) */
    .cp-crumb, .cp-hero, .cp-body {
        --cp-red: #790D16;
        --cp-red-dark: #5E0A11;
        --cp-red-soft: #F5EFE1;
        --cp-navy: #1F2A33;
        --cp-navy-dark: #141C22;
        --cp-navy-soft: #E8EFF4;
        --text-dark: #2d3748;
        --text-gray: #718096;
        --border-color: #E7E1D5;
        --bg-light: #FAF7EF;
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.08);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        --shadow-xl: 0 20px 35px -10px rgb(8 1 89 / 0.22);
        --success-color: #10b981;
        --warning-color: #f59e0b;
    }

    .cp-wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 24px; }

    /* ---------------- Breadcrumb ---------------- */
    .cp-crumb { background: #fff; padding: 16px 0; border-bottom: 1px solid var(--border-color); }
    .cp-crumb ul { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; list-style: none; margin: 0; padding: 0; font-size: 14px; }
    .cp-crumb a { color: var(--text-gray); text-decoration: none; transition: color .3s ease; }
    .cp-crumb a:hover { color: var(--cp-red); }
    .cp-crumb .sep { color: #cbd5e1; }
    .cp-crumb .current { color: var(--text-dark); font-weight: 500; }

    /* ---------------- Hero ---------------- */
    .cp-hero {
        position: relative; overflow: hidden;
        background: #1F2A33;
        padding: 56px 0 96px; color: #fff;
    }
    .cp-hero::before, .cp-hero::after {
        content: ''; position: absolute; border-radius: 50%; pointer-events: none;
        background: none;
    }
    .cp-hero::before { width: 420px; height: 420px; top: -160px; right: -80px; animation: cpFloat 9s ease-in-out infinite; }
    .cp-hero::after  { width: 300px; height: 300px; bottom: -150px; left: -60px; background: none; animation: cpFloat 11s ease-in-out infinite reverse; }
    .cp-hero-grid { position: relative; z-index: 1; display: flex; align-items: center; gap: 32px; }

    .cp-logo-box {
        position: relative; flex-shrink: 0;
        width: 140px; height: 140px; border-radius: 24px; background: #fff;
        box-shadow: 0 18px 40px -12px rgba(0,0,0,.35); padding: 14px;
        display: flex; align-items: center; justify-content: center; overflow: hidden;
        animation: cpPop .7s cubic-bezier(.2,.9,.3,1.3) both .1s;
    }
    /* shimmer skeleton while the logo is loading */
    .cp-logo-box.is-loading::after {
        content: ''; position: absolute; inset: 0;
        background: #F4F0E7;
        background-size: 200% 100%; animation: cpShimmer 1.2s linear infinite;
    }
    .cp-logo-box img { width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .5s ease; }
    .cp-logo-box.is-loaded img { opacity: 1; }
    .cp-logo-initial {
        width: 100%; height: 100%; border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        background: var(--cp-red);
        color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 56px; font-weight: 700;
    }

    .cp-hero-text { min-width: 0; animation: cpRise .7s ease both .25s; }
    .cp-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 13px; font-weight: 600; letter-spacing: .4px; text-transform: uppercase;
        background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.25);
        padding: 6px 14px; border-radius: 6px; margin-bottom: 14px; backdrop-filter: blur(6px);
    }
    .cp-name {
        margin: 0 0 14px; color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif; font-size: 40px; font-weight: 700; line-height: 1.2; word-break: break-word;
    }
    .cp-hero-meta { display: flex; flex-wrap: wrap; gap: 10px 20px; font-size: 15px; color: rgba(255,255,255,.9); }
    .cp-hero-meta span { display: inline-flex; align-items: center; gap: 8px; }
    .cp-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
    .cp-btn {
        display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
        padding: 12px 22px; border-radius: 6px; font-weight: 600; font-size: 15px;
        text-decoration: none; border: 2px solid transparent;
        transition: transform .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
    }
    .cp-btn:hover { transform: translateY(-2px); text-decoration: none; }
    .cp-btn-primary { background: var(--cp-red); color: #fff; box-shadow: 0 10px 22px -8px rgba(31, 42, 51, .7); }
    .cp-btn-primary:hover { background: var(--cp-red-dark); color: #fff; box-shadow: 0 14px 28px -8px rgba(31, 42, 51, .8); }
    .cp-hero .cp-btn-primary { background: #fff; color: var(--cp-red); box-shadow: 0 10px 22px -8px rgba(0,0,0,.35); }
    .cp-hero .cp-btn-primary:hover { background: #fff; color: var(--cp-red-dark); }
    .cp-btn-ghost { background: rgba(255,255,255,.12); color: #fff; border-color: rgba(255,255,255,.4); }
    .cp-btn-ghost:hover { background: #fff; color: var(--cp-red); }

    /* ---------------- Stats strip (overlaps hero) ---------------- */
    .cp-stats {
        position: relative; z-index: 2; margin-top: -56px;
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    }
    .cp-stat {
        background: #fff; border: 1px solid var(--border-color); border-radius: 16px;
        padding: 20px; box-shadow: var(--shadow-lg);
        display: flex; align-items: center; gap: 14px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .cp-stat:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); }
    .cp-stat-icon {
        width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; font-size: 20px;
    }
    .cp-stat:nth-child(1) .cp-stat-icon { background: var(--cp-red-soft); color: var(--cp-red); }
    .cp-stat:nth-child(2) .cp-stat-icon { background: var(--cp-red-soft); color: var(--cp-red-dark); }
    .cp-stat:nth-child(3) .cp-stat-icon { background: #ecfdf5; color: var(--success-color); }
    .cp-stat:nth-child(4) .cp-stat-icon { background: #fffbeb; color: var(--warning-color); }
    .cp-stat-num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: var(--text-dark); line-height: 1.1; }
    .cp-stat-label { font-size: 13px; color: var(--text-gray); margin-top: 2px; }

    /* ---------------- Layout ---------------- */
    .cp-body { background: var(--bg-light); padding: 0 0 90px; }
    .cp-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; margin-top: 32px; align-items: start; }

    .cp-card-section {
        background: #fff; border: 1px solid var(--border-color); border-radius: 12px;
        padding: 30px; box-shadow: var(--shadow-md); margin-bottom: 28px;
    }
    .cp-section-title {
        display: flex; align-items: center; gap: 12px; margin: 0 0 18px;
        font-family: 'Plus Jakarta Sans', sans-serif; font-size: 22px; font-weight: 700; color: var(--text-dark);
    }
    .cp-section-title i {
        width: 40px; height: 40px; border-radius: 10px; font-size: 17px;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--cp-red-soft); color: var(--cp-red);
    }

    /* About */
    .cp-about { position: relative; color: #374151; line-height: 1.8; font-size: 15.5px; white-space: pre-line; }
    .cp-about.is-clamped { max-height: 220px; overflow: hidden; }
    .cp-about.is-clamped::after {
        content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 90px;
        background: linear-gradient(180deg, rgba(255,255,255,0) 0%, #fff 90%);
    }
    .cp-readmore {
        margin-top: 12px; background: none; border: none; padding: 0; cursor: pointer;
        color: var(--cp-red); font-weight: 600; font-size: 15px;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .cp-readmore i { transition: transform .3s ease; }
    .cp-readmore[aria-expanded="true"] i { transform: rotate(180deg); }

    /* Jobs toolbar */
    .cp-jobs-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 20px; }
    .cp-jobs-head .cp-section-title { margin: 0; }
    .cp-search { position: relative; flex: 0 1 280px; margin: 0; }
    .cp-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 14px; }
    .cp-search input {
        width: 100%; padding: 11px 14px 11px 38px; border-radius: 12px;
        border: 1px solid var(--border-color); background: var(--bg-light); font-size: 14px;
        transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
    }
    .cp-search input:focus { outline: none; border-color: var(--cp-red); background: #fff; box-shadow: 0 0 0 4px rgba(121, 13, 22, .12); }

    /* Job cards */
    .cp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    .cp-job {
        position: relative; overflow: hidden;
        display: flex; flex-direction: column; gap: 14px;
        background: #fff; border: 1px solid var(--border-color); border-radius: 16px; padding: 22px;
        color: inherit; text-decoration: none;
        transition: opacity .7s ease, transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }
    .cp-job::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
        background: var(--cp-red-dark);
        transform: scaleX(0); transform-origin: left; transition: transform .4s ease;
    }
    .cp-job.is-visible:hover { transform: translateY(-6px); box-shadow: var(--shadow-xl); border-color: #E5D3AF; }
    .cp-job:hover { color: inherit; text-decoration: none; }
    .cp-job:hover::before { transform: scaleX(1); }
    .cp-job-title { margin: 0; font-size: 17px; font-weight: 700; color: var(--text-dark); line-height: 1.4; transition: color .25s ease; }
    .cp-job:hover .cp-job-title { color: var(--cp-red); }
    .cp-badges { display: flex; flex-wrap: wrap; gap: 6px; }
    .cp-badge { font-size: 11.5px; font-weight: 700; padding: 4px 10px; border-radius: 6px; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; }
    .cp-badge-top { background: #fef3c7; color: #b45309; }
    .cp-badge-new { background: #dcfce7; color: #15803d; }
    .cp-job-meta { display: flex; flex-wrap: wrap; gap: 8px; }
    .cp-chip {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; color: #475569; background: var(--bg-light);
        border: 1px solid var(--border-color); border-radius: 8px; padding: 5px 10px;
    }
    .cp-chip i { color: #94a3b8; font-size: 12px; }
    .cp-salary { font-weight: 700; font-size: 16px; color: var(--cp-red); }
    .cp-job-foot {
        margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--border-color);
        display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
    }
    .cp-closing { font-size: 13px; color: var(--text-gray); display: inline-flex; align-items: center; gap: 6px; }
    .cp-closing.is-urgent { color: var(--cp-red); font-weight: 600; }
    .cp-go {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 14px; font-weight: 600; color: #fff; background: var(--cp-red);
        padding: 8px 14px; border-radius: 10px; transition: background .25s ease, gap .25s ease;
    }
    .cp-job:hover .cp-go { background: var(--cp-red-dark); gap: 12px; }

    .cp-noresults { display: none; text-align: center; color: var(--text-gray); padding: 26px 0 6px; }

    /* Empty state */
    .cp-empty { text-align: center; padding: 40px 10px 20px; }
    .cp-empty-icon {
        width: 84px; height: 84px; margin: 0 auto 18px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--cp-red-soft); color: var(--cp-red); font-size: 34px;
        animation: cpFloat 4s ease-in-out infinite;
    }
    .cp-empty h3 { font-size: 20px; color: var(--text-dark); margin: 0 0 8px; }
    .cp-empty p { color: var(--text-gray); margin: 0 0 20px; }

    /* Pagination */
    .cp-pager { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .cp-pager a, .cp-pager .is-off {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border-color);
        background: #fff; color: var(--cp-red); font-weight: 600; text-decoration: none;
        transition: all .25s ease;
    }
    .cp-pager a:hover { background: var(--cp-red); color: #fff; border-color: var(--cp-red); transform: translateY(-2px); }
    .cp-pager .is-off { color: #cbd5e1; cursor: not-allowed; }
    .cp-pager .cp-pageinfo { color: var(--text-gray); font-size: 14px; }

    /* ---------------- Sidebar ---------------- */
    .cp-side { position: sticky; top: 90px; }
    .cp-side-card {
        background: #fff; border: 1px solid var(--border-color); border-radius: 12px;
        padding: 24px; box-shadow: var(--shadow-md); margin-bottom: 22px;
    }
    .cp-side-card h4 { margin: 0 0 16px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; font-weight: 700; color: var(--text-dark); }
    .cp-glance { list-style: none; margin: 0; padding: 0; }
    .cp-glance li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid #F4F0E7; font-size: 14px; color: #475569; }
    .cp-glance li:last-child { border-bottom: none; padding-bottom: 0; }
    .cp-glance i { width: 18px; color: var(--cp-red); margin-top: 3px; }
    .cp-glance strong { display: block; color: var(--text-dark); font-weight: 600; margin-bottom: 2px; }
    .cp-share { display: flex; gap: 10px; flex-wrap: wrap; }
    .cp-share a, .cp-share button {
        width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--border-color);
        display: inline-flex; align-items: center; justify-content: center;
        background: #fff; color: #475569; font-size: 17px; cursor: pointer; text-decoration: none;
        transition: transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease;
    }
    .cp-share a:hover, .cp-share button:hover { transform: translateY(-3px); color: #fff; border-color: transparent; }
    .cp-share .s-wa:hover { background: #25d366; }
    .cp-share .s-fb:hover { background: #1877f2; }
    .cp-share .s-in:hover { background: #0a66c2; }
    .cp-share .s-copy:hover { background: var(--cp-red); }
    .cp-copied { display: none; margin-top: 10px; font-size: 13px; color: var(--success-color); font-weight: 600; }
    .cp-cta-card { background: #1F2A33; color: #fff; border: none; }
    .cp-cta-card h4 { color: #fff; }
    .cp-cta-card p { color: rgba(255,255,255,.85); font-size: 14px; margin: 0 0 16px; line-height: 1.6; }
    .cp-cta-card .cp-btn { width: 100%; justify-content: center; background: #fff; color: var(--cp-red); box-shadow: none; }
    .cp-cta-card .cp-btn:hover { background: #fff; color: var(--cp-red-dark); }

    /* ---------------- Animations ---------------- */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }
    .cp-job.reveal { transition: opacity .7s ease, transform .45s ease, box-shadow .3s ease, border-color .3s ease; }
    .cp-stats .cp-stat { animation: cpRise .6s ease both; }
    .cp-stats .cp-stat:nth-child(2) { animation-delay: .1s; }
    .cp-stats .cp-stat:nth-child(3) { animation-delay: .2s; }
    .cp-stats .cp-stat:nth-child(4) { animation-delay: .3s; }

    @keyframes cpRise    { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes cpPop     { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: scale(1); } }
    @keyframes cpFloat   { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
    @keyframes cpShimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

    @media (prefers-reduced-motion: reduce) {
        .cp-hero *, .cp-body *, .cp-hero::before, .cp-hero::after { animation: none !important; transition: none !important; }
        .reveal { opacity: 1; transform: none; }
    }

    /* ---------------- Responsive ---------------- */
    @media (max-width: 1024px) {
        .cp-layout { grid-template-columns: 1fr; }
        .cp-side { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
        .cp-side-card { margin-bottom: 0; }
        .cp-stats { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .cp-wrap { padding: 0 16px; }
        .cp-hero { padding: 40px 0 84px; }
        .cp-hero-grid { flex-direction: column; text-align: center; gap: 20px; }
        .cp-logo-box { width: 112px; height: 112px; border-radius: 20px; }
        .cp-logo-initial { font-size: 44px; }
        .cp-name { font-size: 28px; }
        .cp-hero-meta, .cp-hero-actions { justify-content: center; }
        .cp-side { grid-template-columns: 1fr; }
        .cp-card-section { padding: 22px; }
        .cp-jobs-head { flex-direction: column; align-items: stretch; }
        .cp-search { flex-basis: auto; }
    }
    @media (max-width: 480px) {
        .cp-stats { gap: 10px; }
        .cp-stat { padding: 14px; gap: 10px; flex-direction: column; text-align: center; }
        .cp-stat-icon { width: 40px; height: 40px; font-size: 17px; }
        .cp-stat-num { font-size: 20px; }
        .cp-grid { grid-template-columns: 1fr; }
        .cp-hero-actions .cp-btn { flex: 1 1 100%; justify-content: center; }
        .cp-section-title { font-size: 19px; }
    }
    .cp-badge-urgent { background: #fff4ec; color: #c2410c; border: 1px solid #fdba74; }

    /* ---------- Mobile: compact hero (logo left, details right) + one-row stats ---------- */
    @media (max-width: 768px) {
        .cp-hero { padding: 22px 0 66px; }
        .cp-hero-grid { flex-direction: row; align-items: flex-start; text-align: left; gap: 14px; }
        .cp-logo-box { width: 78px; height: 78px; border-radius: 16px; padding: 8px; }
        .cp-logo-initial { font-size: 32px; }
        .cp-hero-text { flex: 1; min-width: 0; }
        .cp-eyebrow, .cp-meta-country, .cp-btn-about { display: none !important; }
        .cp-name { font-size: 21px; line-height: 1.25; margin: 2px 0 6px; }
        .cp-hero-meta { justify-content: flex-start; gap: 4px 14px; font-size: 13px; }
        .cp-hero-meta span { gap: 6px; }
        .cp-hero-actions { justify-content: flex-start; margin-top: 12px; }
        .cp-hero-actions .cp-btn { flex: 0 0 auto; padding: 8px 16px; font-size: 13.5px; border-radius: 6px; gap: 8px; }

        .cp-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: -46px; }
        .cp-stat { flex-direction: column; text-align: center; gap: 6px; padding: 10px 4px; border-radius: 12px; }
        .cp-stat-icon { width: 30px; height: 30px; font-size: 13px; border-radius: 9px; }
        .cp-stat-num { font-size: 17px; }
        .cp-stat-label { font-size: 10.5px; line-height: 1.2; margin-top: 2px; }
    }
    @media (max-width: 360px) {
        .cp-logo-box { width: 64px; height: 64px; }
        .cp-name { font-size: 19px; }
        .cp-stat-label { font-size: 9.5px; }
    }
</style>
{% endblock %}
{% block content %}
<!-- Header Section -->
{% include "partials/header.njk" %}

<!-- Breadcrumb -->
<nav class="cp-crumb" aria-label="Breadcrumb">
    <div class="cp-wrap">
        <ul>
            <li><a href="/">Jobs</a></li>
            <li class="sep">›</li>
            <li><span>Companies</span></li>
            <li class="sep">›</li>
            <li class="current">{{ companyName }}</li>
        </ul>
    </div>
</nav>

<!-- Hero -->
<section class="cp-hero">
    <div class="cp-wrap">
        <div class="cp-hero-grid">
            <div class="cp-logo-box {{ ("is-loading" if company.company_logo else "is-loaded") }}">
                {% if company.company_logo %}
                    <img src="{{ ('/upload/' ~ company.company_logo) }}"
                         alt="{{ companyName }} logo"
                         onload="this.parentNode.classList.remove('is-loading');this.parentNode.classList.add('is-loaded');"
                         onerror="var b=this.parentNode;b.classList.remove('is-loading');b.classList.add('is-loaded');b.innerHTML='&lt;div class=&quot;cp-logo-initial&quot;&gt;{{ initial }}&lt;/div&gt;';">
                {% else %}
                    <div class="cp-logo-initial">{{ initial }}</div>
                {% endif %}
            </div>

            <div class="cp-hero-text">
                <span class="cp-eyebrow"><i class="fas fa-building"></i> Company Profile</span>
                <h1 class="cp-name">{{ companyName }}</h1>
                <div class="cp-hero-meta">
                    <span><i class="fas fa-briefcase"></i> {{ stats.open }} open {{ ('position' | plural(stats.open)) }}</span>
                    {% if stats.locations | length %}
                        <span><i class="fas fa-map-marker-alt"></i>
                            {{ stats.locations | first3 | join(', ') }}{{ (' +' ~ (stats.locations | length - 3) ~ ' more' if stats.locations | length > 3 else "") }}
                        </span>
                    {% endif %}
                    <span class="cp-meta-country"><i class="fas fa-flag"></i> Sri Lanka</span>
                </div>
                <div class="cp-hero-actions">
                    {% if stats.open > 0 %}
                        <a href="#open-jobs" class="cp-btn cp-btn-primary js-scroll"><i class="fas fa-search"></i> View Open Jobs</a>
                    {% else %}
                        <a href="/" class="cp-btn cp-btn-primary"><i class="fas fa-search"></i> Browse All Jobs</a>
                    {% endif %}
                    {% if overview != '' %}
                        <a href="#about-company" class="cp-btn cp-btn-ghost cp-btn-about js-scroll"><i class="fas fa-info-circle"></i> About Company</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<div class="cp-body">
    <div class="cp-wrap">

        <!-- Stats -->
        <div class="cp-stats">
            <div class="cp-stat">
                <div class="cp-stat-icon"><i class="fas fa-briefcase"></i></div>
                <div><div class="cp-stat-num" data-count="{{ stats.open }}">{{ stats.open }}</div><div class="cp-stat-label">Open Positions</div></div>
            </div>
            <div class="cp-stat">
                <div class="cp-stat-icon"><i class="fas fa-map-marked-alt"></i></div>
                <div><div class="cp-stat-num" data-count="{{ stats.locations | length }}">{{ stats.locations | length }}</div><div class="cp-stat-label">{{ ('Location' | plural(stats.locations | length)) }}</div></div>
            </div>
            <div class="cp-stat">
                <div class="cp-stat-icon"><i class="fas fa-layer-group"></i></div>
                <div><div class="cp-stat-num" data-count="{{ stats.jobTypes | length }}">{{ stats.jobTypes | length }}</div><div class="cp-stat-label">{{ ('Job Type' | plural(stats.jobTypes | length)) }}</div></div>
            </div>
            <div class="cp-stat">
                <div class="cp-stat-icon"><i class="fas fa-star"></i></div>
                <div><div class="cp-stat-num" data-count="{{ stats.featured }}">{{ stats.featured }}</div><div class="cp-stat-label">Featured Jobs</div></div>
            </div>
        </div>

        <div class="cp-layout">
            <!-- Main column -->
            <main>
                {% if overview != '' %}
                <section class="cp-card-section reveal" id="about-company">
                    <h2 class="cp-section-title"><i class="fas fa-building"></i> About {{ companyName }}</h2>
                    <div class="cp-about {{ ("is-clamped" if isLongAbout else "") }}" id="cpAbout">{{ overview }}</div>
                    {% if isLongAbout %}
                        <button type="button" class="cp-readmore" id="cpReadMore" aria-expanded="false" aria-controls="cpAbout">
                            <span>Read more</span> <i class="fas fa-chevron-down"></i>
                        </button>
                    {% endif %}
                </section>
                {% endif %}

                <section class="cp-card-section reveal" id="open-jobs">
                    <div class="cp-jobs-head">
                        <h2 class="cp-section-title"><i class="fas fa-briefcase"></i> Open Jobs</h2>
                        {% if jobs | length > 1 %}
                        <label class="cp-search" aria-label="Filter jobs">
                            <i class="fas fa-search"></i>
                            <input type="search" id="cpJobFilter" placeholder="Filter by title, city or type…" autocomplete="off">
                        </label>
                        {% endif %}
                    </div>

                    {% if jobs | length %}
                        <div class="cp-grid" id="cpGrid">
                            {% for job in jobs %}
                                {% set daysLeft = job.days_until_closing %}
                                {% set isNew = job.isNew %}
                                {% set place = job.city_name or job.country_name or 'Sri Lanka' %}
                                <a href="{{ (job | jobUrl) }}"
                                   class="cp-job reveal"
                                   style="transition-delay: {{ ((loop.index0 % 3) * 0.08) | round(2) }}s;"
                                   data-search="{{ ((job.job_title ~ ' ' ~ place ~ ' ' ~ (job.jobtype  or  '') ~ ' ' ~ (job.worktype  or  '')) | lower) }}">
                                    <h3 class="cp-job-title">{{ job.job_title }}</h3>

                                    {% if job.job_adv_top_rated == '1'  or  job.job_adv_urgent == '1'  or  isNew %}
                                    <div class="cp-badges">
                                        {% if job.job_adv_top_rated == '1' %}
                                            <span class="cp-badge cp-badge-top"><i class="fas fa-star"></i> Featured</span>
                                        {% endif %}
                                        {% if job.job_adv_urgent == '1' %}
                                            <span class="cp-badge cp-badge-urgent"><i class="fas fa-bolt"></i> Urgent</span>
                                        {% endif %}
                                        {% if isNew %}
                                            <span class="cp-badge cp-badge-new"><i class="fas fa-bolt"></i> New</span>
                                        {% endif %}
                                    </div>
                                    {% endif %}

                                    <div class="cp-job-meta">
                                        <span class="cp-chip"><i class="fas fa-map-marker-alt"></i> {{ place }}</span>
                                        {% if job.jobtype %}
                                            <span class="cp-chip"><i class="fas fa-clock"></i> {{ job.jobtype }}</span>
                                        {% endif %}
                                        {% if job.worktype %}
                                            <span class="cp-chip"><i class="fas fa-laptop-house"></i> {{ job.worktype }}</span>
                                        {% endif %}
                                    </div>

                                    <div class="cp-salary">
                                        {{ ('LKR ' ~ job.job_adv_salary if job.job_adv_salary else "Salary Negotiable") }}
                                    </div>

                                    <div class="cp-job-foot">
                                        <span class="cp-closing {{ ("is-urgent" if daysLeft != null  and  daysLeft <= 3 else "") }}">
                                            <i class="far fa-calendar-alt"></i>
                                            {% if daysLeft == null %}
                                                Open
                                            {% elif daysLeft <= 0 %}
                                                Closes today
                                            {% elif daysLeft == 1 %}
                                                1 day left
                                            {% elif daysLeft <= 14 %}
                                                {{ daysLeft }} days left
                                            {% else %}
                                                Closes {{ (job.job_adv_closingdate | fmtDate) }}
                                            {% endif %}
                                        </span>
                                        <span class="cp-go">View &amp; Apply <i class="fas fa-arrow-right"></i></span>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>

                        <p class="cp-noresults" id="cpNoResults"><i class="fas fa-search"></i> No jobs on this page match your filter.</p>

                        {% if false %}{# single page in the prototype (<= 12 jobs per company) #}
                        <div class="cp-pager">
                            {% if true %}
                                <span class="is-off"><i class="fas fa-chevron-left"></i> Previous</span>
                            {% else %}
                                <a href="##open-jobs"><i class="fas fa-chevron-left"></i> Previous</a>
                            {% endif %}
                            <span class="cp-pageinfo">Page 1 of 1</span>
                            {% if false %}
                                <a href="##open-jobs">Next <i class="fas fa-chevron-right"></i></a>
                            {% else %}
                                <span class="is-off">Next <i class="fas fa-chevron-right"></i></span>
                            {% endif %}
                        </div>
                        {% endif %}
                    {% else %}
                        <div class="cp-empty">
                            <div class="cp-empty-icon"><i class="fas fa-briefcase"></i></div>
                            <h3>No open positions right now</h3>
                            <p>{{ companyName }} isn't hiring at the moment. Check back soon or explore other opportunities.</p>
                            <a href="/" class="cp-btn cp-btn-primary"><i class="fas fa-search"></i> Browse All Jobs</a>
                        </div>
                    {% endif %}
                </section>
            </main>

            <!-- Sidebar -->
            <aside class="cp-side">
                <div class="cp-side-card reveal">
                    <h4>Company at a glance</h4>
                    <ul class="cp-glance">
                        <li><i class="fas fa-building"></i><div><strong>Company</strong>{{ companyName }}</div></li>
                        <li><i class="fas fa-briefcase"></i><div><strong>Hiring now</strong>{{ stats.open }} open {{ ('position' | plural(stats.open)) }}</div></li>
                        {% if stats.locations | length %}
                            <li><i class="fas fa-map-marker-alt"></i><div><strong>Locations</strong>{{ stats.locations | join(', ') }}</div></li>
                        {% endif %}
                        {% if stats.jobTypes | length %}
                            <li><i class="fas fa-layer-group"></i><div><strong>Job types</strong>{{ stats.jobTypes | join(', ') }}</div></li>
                        {% endif %}
                    </ul>
                </div>

                <div class="cp-side-card reveal">
                    <h4>Share this company</h4>
                    <div class="cp-share">
                        <a class="s-wa" href="https://wa.me/?text={{ (shareText ~ ' - ' ~ shareUrl) | urlencode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        <a class="s-fb" href="https://www.facebook.com/sharer/sharer.php?u={{ (shareUrl) | urlencode }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a class="s-in" href="https://www.linkedin.com/sharing/share-offsite/?url={{ (shareUrl) | urlencode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                        <button type="button" class="s-copy" id="cpCopyLink" data-url="{{ shareUrl }}" aria-label="Copy link"><i class="fas fa-link"></i></button>
                    </div>
                    <div class="cp-copied" id="cpCopied"><i class="fas fa-check-circle"></i> Link copied!</div>
                </div>

                <div class="cp-side-card cp-cta-card reveal">
                    <h4>Build a standout CV</h4>
                    <p>Make your application shine with our free resume builder before you apply.</p>
                    <a href="https://resume-builder.job-labs.lk/" target="_blank" rel="noopener" class="cp-btn cp-btn-primary"><i class="fas fa-file-alt"></i> Resume Builder</a>
                </div>
            </aside>
        </div>
    </div>
</div>

{% include "partials/footer.njk" %}
{% endblock %}
{% block scripts %}
<script>
(function () {
    function init() {
        /* Scroll reveal (same pattern as the job details page) */
        var revealEls = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        var el = entry.target;
                        el.classList.add('is-visible');
                        io.unobserve(el);
                        /* drop the stagger delay once revealed so hover feels instant */
                        if (el.style.transitionDelay) {
                            setTimeout(function () { el.style.transitionDelay = ''; }, 900);
                        }
                    }
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
            revealEls.forEach(function (el) { io.observe(el); });
        } else {
            revealEls.forEach(function (el) { el.classList.add('is-visible'); });
        }

        /* Count-up for the stats */
        document.querySelectorAll('.cp-stat-num[data-count]').forEach(function (el) {
            var target = parseInt(el.getAttribute('data-count'), 10) || 0;
            if (target < 2) return;
            var start = null, duration = 900;
            el.textContent = '0';
            function step(ts) {
                if (!start) start = ts;
                var p = Math.min((ts - start) / duration, 1);
                el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        });

        /* Smooth scroll for hero buttons (offset for sticky header) */
        document.querySelectorAll('.js-scroll').forEach(function (link) {
            link.addEventListener('click', function (e) {
                var target = document.querySelector(this.getAttribute('href'));
                if (!target) return;
                e.preventDefault();
                e.stopImmediatePropagation();
                var top = target.getBoundingClientRect().top + window.pageYOffset - 90;
                window.scrollTo({ top: top, behavior: 'smooth' });
            });
        });

        /* Read more / less for long company descriptions */
        var readMore = document.getElementById('cpReadMore');
        var about = document.getElementById('cpAbout');
        if (readMore && about) {
            readMore.addEventListener('click', function () {
                var open = !about.classList.toggle('is-clamped');
                readMore.setAttribute('aria-expanded', open ? 'true' : 'false');
                readMore.querySelector('span').textContent = open ? 'Show less' : 'Read more';
            });
        }

        /* Instant filter for the job cards on this page */
        var filter = document.getElementById('cpJobFilter');
        if (filter) {
            var cards = document.querySelectorAll('#cpGrid .cp-job');
            var none = document.getElementById('cpNoResults');
            filter.addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                var shown = 0;
                cards.forEach(function (card) {
                    var hit = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
                    card.style.display = hit ? '' : 'none';
                    if (hit) { shown++; card.classList.add('is-visible'); }
                });
                if (none) none.style.display = shown ? 'none' : 'block';
            });
        }

        /* Copy link */
        var copyBtn = document.getElementById('cpCopyLink');
        if (copyBtn) {
            copyBtn.addEventListener('click', function () {
                var url = this.getAttribute('data-url');
                var done = function () {
                    var msg = document.getElementById('cpCopied');
                    if (!msg) return;
                    msg.style.display = 'block';
                    setTimeout(function () { msg.style.display = 'none'; }, 2200);
                };
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(url).then(done).catch(function () { window.prompt('Copy this link:', url); });
                } else {
                    window.prompt('Copy this link:', url);
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    /* Shared links (…/company/x/name#open-jobs) land on the Open Jobs section.
       Wait until the page (logo, images, loader) has settled, then scroll with
       room for the sticky header. */
    if (window.location.hash === '#open-jobs') {
        if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
        var goToJobs = function () {
            var target = document.getElementById('open-jobs');
            if (!target) return;
            target.classList.add('is-visible');
            var targetTop = function () {
                return Math.max(0, target.getBoundingClientRect().top + window.pageYOffset - 90);
            };
            window.scrollTo({ top: targetTop(), behavior: 'smooth' });
            /* Backup: if smooth scrolling was interrupted (slow device, background tab),
               jump straight there so the visitor always lands on Open Jobs. */
            setTimeout(function () {
                if (Math.abs(window.pageYOffset - targetTop()) > 40) {
                    document.documentElement.style.scrollBehavior = 'auto';
                    window.scrollTo(0, targetTop());
                    document.documentElement.style.scrollBehavior = '';
                }
            }, 1200);
        };
        var onReady = function () { setTimeout(goToJobs, 350); };
        if (document.readyState === 'complete') { onReady(); } else { window.addEventListener('load', onReady); }
    }
})();
</script>
{% endblock %}

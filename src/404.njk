<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>404 — Page Not Found | Job Labs</title>
    <link rel="shortcut icon" href="/favicon.ico">
    
    <!-- Google Fonts: Inter & Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --primary-blue: #080159;
            --dark-blue: #050138;
            --primary-orange: #A92036;
            --orange-hover: #801225;
            --accent: #A92036;
            --accent-dark: #801225;
            --accent-navy: #080159;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --bg-light: #f8f9ff;
        }

        html, body {
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-light);
            color: var(--text-dark);
            -webkit-font-smoothing: antialiased;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient background decoration matching Job Labs */
        .bg-decoration {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-pattern {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(8, 1, 89, 0.05) 1px, transparent 1px);
            background-size: 24px 24px;
            opacity: 0.7;
        }

        .bg-glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.12;
        }

        .bg-glow-1 {
            width: 500px;
            height: 500px;
            background: var(--primary-blue);
            top: -150px;
            right: -100px;
        }

        .bg-glow-2 {
            width: 450px;
            height: 450px;
            background: var(--primary-orange);
            bottom: -100px;
            left: -100px;
        }

        /* Main container */
        .error-page {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem 2rem;
            position: relative;
            z-index: 1;
        }

        /* Real Brand Logo */
        .brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2.5rem;
            text-decoration: none;
            transition: transform 0.3s ease;
        }

        .brand:hover {
            transform: translateY(-2px);
        }

        .brand-logo-img {
            height: 48px;
            width: auto;
            max-width: 220px;
            object-fit: contain;
        }

        .brand-fallback {
            display: none;
            align-items: center;
            gap: 10px;
        }

        .brand-fallback-icon {
            width: 42px;
            height: 42px;
            background: var(--primary-orange);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .brand-fallback-name {
            font-family: 'Poppins', sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-blue);
        }

        .brand-fallback-name span {
            color: var(--primary-orange);
        }

        /* Error card */
        .error-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 10px 25px -5px rgba(8, 1, 89, 0.08), 0 20px 45px -10px rgba(8, 1, 89, 0.12);
            border: 1px solid rgba(8, 1, 89, 0.08);
            padding: 3.25rem 3.5rem;
            max-width: 580px;
            width: 100%;
            text-align: center;
            animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

        /* Top accent line */
        .error-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 40px;
            right: 40px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-blue), var(--primary-orange));
            border-radius: 0 0 4px 4px;
        }

        /* Error icon circle */
        .error-icon-wrap {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, #fdf2f4, #ffe4e8);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            position: relative;
        }

        .error-icon-wrap i {
            font-size: 2.4rem;
            color: var(--accent);
        }

        /* Pulse ring */
        .error-icon-wrap::before {
            content: '';
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 2px solid var(--accent);
            opacity: 0.25;
            animation: pulse 2.5s ease-in-out infinite;
        }

        /* Error code */
        .error-code {
            font-family: 'Poppins', sans-serif;
            font-size: 5.5rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.04em;
            background: linear-gradient(135deg, var(--accent-navy, #080159) 0%, var(--accent, #A92036) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        /* Divider */
        .error-divider {
            width: 50px;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-navy, #080159), var(--accent, #A92036));
            border-radius: 3px;
            margin: 0 auto 1.5rem;
        }

        .error-title {
            font-family: 'Poppins', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary-blue);
            margin-bottom: 0.85rem;
            line-height: 1.3;
        }

        .error-message {
            font-size: 0.98rem;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 2rem;
        }

        /* Action buttons */
        .error-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 1.75rem;
        }

        .btn-home {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.85rem 1.8rem;
            background: linear-gradient(135deg, var(--primary-orange) 0%, var(--orange-hover) 100%);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 14px rgba(169, 32, 54, 0.3);
        }

        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(169, 32, 54, 0.4);
            color: white;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.85rem 1.6rem;
            background: #ffffff;
            color: var(--primary-blue);
            border: 1.5px solid var(--border-color);
            border-radius: 50px;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-back:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
            transform: translateY(-2px);
            color: var(--primary-blue);
        }

        /* Quick Discovery Links */
        .error-quick-links {
            padding-top: 1.5rem;
            border-top: 1px solid #f1f5f9;
        }

        .quick-links-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 0.85rem;
        }

        .quick-links-pills {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .quick-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: #f8f9ff;
            color: var(--primary-blue);
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .quick-pill:hover {
            background: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
            transform: translateY(-1px);
        }

        .quick-pill i {
            color: var(--primary-orange);
            font-size: 0.8rem;
        }

        .quick-pill:hover i {
            color: white;
        }

        /* Extra text info */
        .error-extra {
            margin-top: 1.25rem;
            font-size: 0.85rem;
            color: #94a3b8;
            line-height: 1.6;
        }

        .error-extra a {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .error-extra a:hover {
            color: var(--dark-blue);
            text-decoration: underline;
        }

        /* Footer */
        .error-footer {
            padding: 1.75rem 1rem;
            text-align: center;
            font-size: 0.85rem;
            color: #94a3b8;
            position: relative;
            z-index: 1;
        }

        /* Animations */
        @keyframes popIn {
            from { opacity: 0; transform: translateY(20px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.25; }
            50% { transform: scale(1.1); opacity: 0.1; }
        }

        /* Responsive */
        @media (max-width: 600px) {
            .error-card {
                padding: 2.25rem 1.5rem;
                border-radius: 20px;
            }
            .error-card::before {
                left: 20px;
                right: 20px;
            }
            .error-code {
                font-size: 4.2rem;
            }
            .error-title {
                font-size: 1.35rem;
            }
            .brand {
                margin-bottom: 2rem;
            }
            .btn-home, .btn-back {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- Ambient background decoration -->
    <div class="bg-decoration">
        <div class="bg-pattern"></div>
        <div class="bg-glow bg-glow-1"></div>
        <div class="bg-glow bg-glow-2"></div>
    </div>

    <!-- Main error page -->
    <main class="error-page">

        <!-- Authentic Job Labs Brand Logo -->
        <a href="/" class="brand" aria-label="Job Labs Home">
            <img src="/assets/front/images/hr/job_logo.png"
                 alt="Job Labs"
                 class="brand-logo-img"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">
            <div class="brand-fallback">
                <div class="brand-fallback-icon"><i class="fas fa-briefcase"></i></div>
                <span class="brand-fallback-name">Job <span>Labs</span></span>
            </div>
        </a>

        <!-- Error Card -->
        <div class="error-card">
            <div class="error-icon-wrap">
                <i class="fas fa-compass"></i>
            </div>

            <div class="error-code">404</div>
            <div class="error-divider"></div>
            <h1 class="error-title">Page Not Found</h1>
            <p class="error-message">The page you are looking for might have been moved, renamed, or is temporarily unavailable. Let us help you get back on track.</p>

            <div class="error-actions">
                <a href="javascript:history.back()" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Go Back
                </a>
                <a href="/" class="btn-home">
                    <i class="fas fa-home"></i> Go to Home
                </a>
            </div>

            <!-- Quick Navigation Pills to help user find what they need -->
            <div class="error-quick-links">
                <div class="quick-links-title">Popular Destinations</div>
                <div class="quick-links-pills">
                    <a href="/" class="quick-pill">
                        <i class="fas fa-search"></i> Job Vacancies
                    </a>
                    <a href="/services" class="quick-pill">
                        <i class="fas fa-briefcase"></i> Services
                    </a>
                    <a href="/about-us" class="quick-pill">
                        <i class="fas fa-info-circle"></i> About Us
                    </a>
                    <a href="/faq" class="quick-pill">
                        <i class="fas fa-question-circle"></i> FAQ
                    </a>
                    <a href="/contact" class="quick-pill">
                        <i class="fas fa-envelope"></i> Contact Us
                    </a>
                </div>
            </div>

            
            <div class="error-extra">
                <p>Looking for help? Browse our <a href="/faq">FAQ</a> or <a href="/contact">contact our support team</a>.</p>
            </div>
            
        </div>

    </main>

    <!-- Footer -->
    <footer class="error-footer">
        &copy; {{ site.year }} Job Labs. All rights reserved.
    </footer>

</body>
</html>

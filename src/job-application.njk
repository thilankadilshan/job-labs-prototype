{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('applicationForm');
    const submitBtn = document.getElementById('submitBtn');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const submitIcon = document.getElementById('submitIcon');
    const submitText = document.getElementById('submitText');
    const cvInput = document.getElementById('candidate_cv');
    const cvLabel = document.getElementById('cv-label');
    const cvText = document.getElementById('cv-text');

    // Initialize international telephone input
    const phoneInput = document.querySelector("#candidate_mobile");
    const countryCodeInput = document.querySelector("#country_code");
    
    // Initialize intl-tel-input
    const iti = window.intlTelInput(phoneInput, {
        initialCountry: "auto",
        geoIpLookup: function(callback) {
            fetch('https://ipapi.co/json/')
                .then(response => response.json())
                .then(data => {
                    const countryCode = data.country_code?.toLowerCase() || 'lk';
                    callback(countryCode);
                })
                .catch(() => {
                    callback('lk'); // Default to Sri Lanka if detection fails
                });
        },
        preferredCountries: ['lk', 'in', 'gb', 'us', 'ae'], // Prioritize these countries
        separateDialCode: true,
        formatOnDisplay: true,
        autoPlaceholder: "aggressive",
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
    });

    // Update hidden country code field when country changes
    phoneInput.addEventListener('countrychange', function() {
        const countryData = iti.getSelectedCountryData();
        countryCodeInput.value = countryData.dialCode;
    });

    // Set initial country code
    const initialCountryData = iti.getSelectedCountryData();
    countryCodeInput.value = initialCountryData.dialCode;

    // Fallback validator for Sri Lankan mobile numbers.
    function isValidSriLankanMobile() {
        const data = iti.getSelectedCountryData();
        if (!data || data.iso2 !== 'lk') {
            return false;
        }

        let digits = phoneInput.value.replace(/\D/g, '');

        if (digits.length === 11 && digits.startsWith('94')) {
            digits = digits.substring(2);
        }
        if (digits.length === 10 && digits.startsWith('0')) {
            digits = digits.substring(1);
        }

        return /^7[0-9]\d{7}$/.test(digits);
    }

    // Update form validation for phone number
    function validatePhoneNumber() {
        const phoneNumber = phoneInput.value.trim();
        const isValid = phoneNumber && (iti.isValidNumber() || isValidSriLankanMobile());

        if (!phoneNumber) {
            showError('candidate_mobile', 'Mobile number is required.');
            return false;
        } else if (!isValid) {
            showError('candidate_mobile', 'Please enter a valid mobile number.');
            return false;
        } else {
            clearError('candidate_mobile');
            return true;
        }
    }

    ///////////////////////////////////////////////
    
    // File upload handling
    cvInput.addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
            cvText.textContent = file.name;
            cvLabel.classList.add('has-file');
            clearError('candidate_cv');
        } else {
            cvText.textContent = 'Choose CV file or drag and drop';
            cvLabel.classList.remove('has-file');
        }
    });

    // Drag and drop functionality
    cvLabel.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.style.borderColor = 'var(--primary-blue)';
        this.style.backgroundColor = '#E8EFF4';
    });

    cvLabel.addEventListener('dragleave', function(e) {
        e.preventDefault();
        this.style.borderColor = 'var(--border-color)';
        this.style.backgroundColor = '#FBF9F4';
    });

    cvLabel.addEventListener('drop', function(e) {
        e.preventDefault();
        this.style.borderColor = 'var(--border-color)';
        this.style.backgroundColor = '#FBF9F4';
        
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            const file = files[0];
            if (file.type === 'application/pdf' || 
                file.type === 'application/msword' || 
                file.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
                cvInput.files = files;
                cvText.textContent = file.name;
                cvLabel.classList.add('has-file');
                clearError('candidate_cv');
            } else {
                showError('candidate_cv', 'Please upload only PDF, DOC, or DOCX files.');
            }
        }
    });

    // Form validation
    function validateForm() {
        let isValid = true;
        clearAllErrors();

        const requiredFields = [
            'candidate_title',
            'candidate_fname', 
            'candidate_lname',
            'candidate_email',
            'candidate_mobile',
            'candidate_location',
            'information_verified'
        ];

        requiredFields.forEach(fieldName => {
            const field = document.querySelector(`[name="${fieldName}"]`);
            if (!field.value.trim()) {
                showError(fieldName, 'This field is required.');
                isValid = false;
            }
        });

        const email = document.querySelector('[name="candidate_email"]').value;
        if (email && !isValidEmail(email)) {
            showError('candidate_email', 'Please enter a valid email address.');
            isValid = false;
        }

        if (!cvInput.files || !cvInput.files[0]) {
            showError('candidate_cv', 'Please upload your CV.');
            isValid = false;
        } else {
            const file = cvInput.files[0];
            const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
            const maxSize = 5 * 1024 * 1024; // 5MB

            if (!allowedTypes.includes(file.type)) {
                showError('candidate_cv', 'Please upload only PDF, DOC, or DOCX files.');
                isValid = false;
            }

            if (file.size > maxSize) {
                showError('candidate_cv', 'File size must be less than 5MB.');
                isValid = false;
            }
        }

        if (!validatePhoneNumber()) {
            isValid = false;
        }

        phoneInput.addEventListener('blur', validatePhoneNumber);
        
        phoneInput.addEventListener('input', function() {
            if (this.style.borderColor === 'var(--error-color)') {
                clearError('candidate_mobile');
            }
        });

        const verificationCheckbox = document.querySelector('[name="information_verified"]');
        if (!verificationCheckbox.checked) {
            showError('information_verified', 'You must confirm that the information provided is accurate.');
            isValid = false;
        }


        return isValid;
    }

    

    function isValidEmail(email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
    }

    function showError(fieldName, message) {
        const errorElement = document.getElementById(`error-${fieldName}`);
        if (errorElement) {
            errorElement.textContent = message;
            errorElement.classList.add('show');
        }

        const field = document.querySelector(`[name="${fieldName}"]`);
        if (field) {
            if (field.type === 'checkbox') {
                document.querySelector('.verification-section').classList.add('checkbox-error');
            } else {
                field.style.borderColor = 'var(--error-color)';
            }
        }
    }

    function clearError(fieldName) {
        const errorElement = document.getElementById(`error-${fieldName}`);
        if (errorElement) {
            errorElement.classList.remove('show');
        }

        const field = document.querySelector(`[name="${fieldName}"]`);
        if (field) {
            if (field.type === 'checkbox') {
                document.querySelector('.verification-section').classList.remove('checkbox-error');
            } else {
                field.style.borderColor = 'var(--border-color)';
            }
        }
    }

    function clearAllErrors() {
        const errorElements = document.querySelectorAll('.form-error');
        errorElements.forEach(error => error.classList.remove('show'));

        const fields = document.querySelectorAll('.form-input');
        fields.forEach(field => {
            field.style.borderColor = 'var(--border-color)';
        });
    }

    function showAlert(type, message) {
        const alertElement = document.getElementById(`alert-${type}`);
        const messageElement = document.getElementById(`${type}-message`);
        
        if (alertElement && messageElement) {
            messageElement.textContent = message;
            alertElement.classList.add('show');
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
            
            setTimeout(() => {
                alertElement.classList.remove('show');
            }, 10000);
        }
    }

    function hideAlerts() {
        document.getElementById('alert-success').classList.remove('show');
        document.getElementById('alert-error').classList.remove('show');
    }

    function setLoading(loading) {
        if (loading) {
            submitBtn.disabled = true;
            loadingSpinner.classList.add('show');
            submitIcon.style.display = 'none';
            submitText.textContent = 'Submitting...';
        } else {
            submitBtn.disabled = false;
            loadingSpinner.classList.remove('show');
            submitIcon.style.display = 'block';
            submitText.textContent = 'Submit Application';
        }
    }

    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        hideAlerts();
        
        if (!validateForm()) {
            showAlert('error', 'Please correct the errors below and try again.');
            return;
        }
        const csrfToken = document.querySelector('meta[name="csrf-token"]') || document.querySelector('input[name="_token"]');

        setLoading(true);
        const formData = new FormData(form);

        fetch(`{{ ((job | jobUrl) ~ '/apply') }}`, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-TOKEN': csrfToken ? csrfToken.getAttribute ? csrfToken.getAttribute('content') : csrfToken.value : ''
            }
        })
        .then(async response => {
            const data = await response.json();
            
            if (response.ok && data.success) {
                showAlert('success', data.message);
                form.reset();
                cvText.textContent = 'Choose CV file or drag and drop';
                cvLabel.classList.remove('has-file');
                
                setTimeout(() => {
                    if (data.redirect_url) {
                        window.location.href = data.redirect_url;
                    }
                }, 3000);
                
            } else {
                if (data.errors) {
                    Object.keys(data.errors).forEach(fieldName => {
                        const errors = data.errors[fieldName];
                        if (errors.length > 0) {
                            showError(fieldName, errors[0]);
                        }
                    });
                    showAlert('error', 'Please correct the errors below and try again.');
                } else {
                    showAlert('error', data.message || 'An error occurred while submitting your application.');
                }
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlert('error', 'A network error occurred. Please check your connection and try again.');
        })
        .finally(() => {
            setLoading(false);
        });
    });

    const inputs = document.querySelectorAll('.form-input');
    inputs.forEach(input => {
        input.addEventListener('blur', function() {
            const fieldName = this.name;
            if (this.hasAttribute('required') && !this.value.trim()) {
                showError(fieldName, 'This field is required.');
            } else {
                clearError(fieldName);
            }
        });

        input.addEventListener('input', function() {
            if (this.style.borderColor === 'var(--error-color)') {
                clearError(this.name);
            }
        });

        const verificationCheckbox = document.querySelector('[name="information_verified"]');
        if (verificationCheckbox) {
            verificationCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    clearError('information_verified');
                    document.querySelector('.verification-section').classList.remove('checkbox-error');
                }
            });
        }
    });

    document.querySelector('[name="candidate_email"]').addEventListener('blur', function() {
        const email = this.value.trim();
        if (email && !isValidEmail(email)) {
            showError('candidate_email', 'Please enter a valid email address.');
        } else if (email) {
            clearError('candidate_email');
        }
    });

    const coverLetter = document.getElementById('candidate_covingletter');
    if (coverLetter) {
        const maxLength = 1000;
        
        const charCounter = document.createElement('div');
        charCounter.style.textAlign = 'right';
        charCounter.style.fontSize = '0.85rem';
        charCounter.style.color = 'var(--text-gray)';
        charCounter.style.marginTop = '5px';
        coverLetter.parentNode.appendChild(charCounter);
        
        function updateCharCount() {
            const remaining = maxLength - coverLetter.value.length;
            charCounter.textContent = `${coverLetter.value.length}/${maxLength} characters`;
            
            if (remaining < 100) {
                charCounter.style.color = 'var(--warning-color)';
            } else if (remaining < 0) {
                charCounter.style.color = 'var(--error-color)';
                coverLetter.value = coverLetter.value.substring(0, maxLength);
            } else {
                charCounter.style.color = 'var(--text-gray)';
            }
        }
        
        coverLetter.addEventListener('input', updateCharCount);
        updateCharCount(); 
    }

    function scrollToFirstError() {
        const firstError = document.querySelector('.form-error.show');
        if (firstError) {
            const field = firstError.previousElementSibling;
            if (field) {
                field.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'center' 
                });
                field.focus();
            }
        }
    }

    const originalValidateForm = validateForm;
    validateForm = function() {
        const isValid = originalValidateForm();
        if (!isValid) {
            setTimeout(scrollToFirstError, 100);
        }
        return isValid;
    };

    const mobileApplyBtn = document.getElementById('mobileApplyBtn');
    if (mobileApplyBtn) {
        mobileApplyBtn.addEventListener('click', function () {
            const target = document.getElementById('applicationFormSection');
            if (target) {
                const offset = 20; 
                const y = target.getBoundingClientRect().top + window.pageYOffset - offset;
                window.scrollTo({ top: y, behavior: 'smooth' });

                mobileApplyBtn.style.transform = 'scale(0.96)';
                setTimeout(function () {
                    mobileApplyBtn.style.transform = '';
                }, 180);
            }
        });
    }
});

const additionalStyles = `
    .form-input:invalid {
        border-color: var(--error-color);
    }
    
    .form-input:valid {
        border-color: var(--success-color);
    }
    
    .form-input:focus:invalid {
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
    }
    
    .form-input:focus:valid {
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }
`;

const styleSheet = document.createElement('style');
styleSheet.textContent = additionalStyles;
document.head.appendChild(styleSheet);
</script>
{% endblock %}

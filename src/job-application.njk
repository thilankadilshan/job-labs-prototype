---
pagination:
  data: jobs
  size: 1
  alias: job
permalink: "/{{ job.job_refno }}/{{ job.slug }}/apply/"
---
{% extends "layouts/master.njk" %}
{% block title %}{{ 'Apply for ' ~ job.job_title ~ ' at ' ~ (job.company_name  or  'Company') ~ ' | Job Labs' }}{% endblock %}
{% block description %}{{ 'Submit your application for ' ~ job.job_title ~ ' position in Sri Lanka.' }}{% endblock %}
{% block og_title %}{{ 'Apply for ' ~ job.job_title ~ ' at ' ~ (job.company_name  or  'Company') ~ ' | Job Labs' }}{% endblock %}
{% block og_image %}{{ ('/upload/' ~ job.company_logo) if job.company_logo else '/assets/front/images/hr/job_logo.png' }}{% endblock %}
{% block og_description %}{{ 'Submit your application for ' ~ job.job_title ~ ' position in Sri Lanka.' }}{% endblock %}
{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css">

<style>
    :root {
        --primary-blue: #3D5568;
        --primary-orange: #790D16;
        --dark-blue: #2C4050;
        --text-dark: #1f2937;
        --text-gray: #6b7280;
        --border-color: #E7E1D5;
        --bg-light: #FBF9F4;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --error-color: #ef4444;
    }

    .application-container {
        min-height: 100vh;
        padding: 40px 0;
        background: var(--bg-light);
    }

    .application-header {
        background: white;
        padding: 30px 0;
        margin-bottom: 40px;
        border-bottom: 1px solid var(--border-color);
        box-shadow: var(--shadow-sm);
    }

    .application-title {
        text-align: center;
        margin-bottom: 30px;
    }

    .application-title h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 10px;
        line-height: 1.2;
    }

    .application-subtitle {
        font-size: 1.2rem;
        color: var(--text-gray);
        margin-bottom: 20px;
    }

    .job-summary-card {
        background: #1F2A33;
        color: white;
        padding: 25px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: var(--shadow-lg);
    }

    .job-summary-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 12px;
        /* Highlighted position title */
        display: inline-block;
        border-bottom: 2.5px solid rgba(255, 255, 255, 0.75);
        padding-bottom: 6px;
        letter-spacing: 0.01em;
        text-shadow: 0 1px 3px rgba(0,0,0,0.15);
    }

    .job-summary-company {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 15px;
    }

    .job-summary-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        font-size: 0.95rem;
        opacity: 0.8;
    }

    /* ── Mobile Apply Now Button ──────────────────────────────────── */
    .mobile-apply-btn-wrapper {
        display: none; /* hidden on desktop */
    }

    .btn-mobile-apply {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 20px;
        width: 100%;
        padding: 15px 24px;
        background: #ffffff;
        color: var(--primary-orange);
        font-size: 1.05rem;
        font-weight: 700;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 18px rgba(0,0,0,0.18);
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
    }

    .btn-mobile-apply:active {
        transform: scale(0.97);
    }

    /* Ripple shine sweep on the button */
    .btn-mobile-apply::before {
        content: '';
        position: absolute;
        top: 0;
        left: -75%;
        width: 50%;
        height: 100%;
        background: linear-gradient(
            120deg,
            transparent 0%,
            rgba(121, 13, 22, 0.12) 50%,
            transparent 100%
        );
        animation: btn-shine 2.4s ease-in-out infinite;
    }

    @keyframes btn-shine {
        0%   { left: -75%; }
        60%  { left: 130%; }
        100% { left: 130%; }
    }

    /* Pulse ring around the button */
    .btn-mobile-apply-pulse {
        position: relative;
        display: block;
        width: 100%;
    }

    .btn-mobile-apply-pulse::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 6px;
        border: 2.5px solid rgba(255,255,255,0.55);
        animation: pulse-ring 2s ease-out infinite;
        pointer-events: none;
    }

    @keyframes pulse-ring {
        0%   { opacity: 1; transform: scale(1); }
        70%  { opacity: 0; transform: scale(1.05); }
        100% { opacity: 0; transform: scale(1.05); }
    }

    /* Arrow bounce */
    .btn-mobile-apply .arrow-down {
        animation: arrow-bounce 1.4s ease-in-out infinite;
    }

    @keyframes arrow-bounce {
        0%, 100% { transform: translateY(0); }
        45%       { transform: translateY(4px); }
    }

    @media (max-width: 768px) {
        /* Show mobile apply button */
        .mobile-apply-btn-wrapper {
            display: block;
        }

        /* More prominent title highlight on mobile */
        .job-summary-title {
            font-size: 1.35rem;
            border-bottom-width: 3px;
            border-bottom-color: rgba(255,255,255,0.9);
            padding-bottom: 8px;
        }
    }

    .form-container {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border-color);
    }

    .form-section {
        margin-bottom: 40px;
    }

    .form-section-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-orange);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-section-icon {
        width: 20px;
        height: 20px;
        color: var(--primary-orange);
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        font-weight: 500;
        color: var(--text-dark);
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .form-label.required::after {
        content: ' *';
        color: var(--error-color);
    }

    .form-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: #ffffff;
        color: var(--text-dark);
    }

    .form-input:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 3px rgba(61, 85, 104, 0.1);
        transform: translateY(-1px);
    }

    .form-input:hover {
        border-color: var(--primary-blue);
    }

    .form-select {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 12px center;
        background-repeat: no-repeat;
        background-size: 16px;
        padding-right: 40px;
    }

    .form-textarea {
        min-height: 120px;
        resize: vertical;
        font-family: inherit;
    }

    .form-file {
        position: relative;
        overflow: hidden;
        display: inline-block;
        width: 100%;
    }

    .form-file input[type="file"] {
        position: absolute;
        left: -9999px;
    }

    .file-input-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 20px;
        border: 2px dashed var(--border-color);
        border-radius: 6px;
        background-color: #FBF9F4;
        color: var(--text-gray);
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .file-input-label:hover {
        border-color: var(--primary-blue);
        background-color: #E8EFF4;
        color: var(--primary-blue);
    }

    .file-input-label.has-file {
        border-color: var(--success-color);
        background-color: #f0fdf4;
        color: var(--success-color);
        border-style: solid;
    }

    .file-icon {
        width: 24px;
        height: 24px;
    }

    .file-info {
        margin-top: 8px;
        font-size: 0.85rem;
        color: var(--text-gray);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-error {
        color: var(--error-color);
        font-size: 0.85rem;
        margin-top: 5px;
        display: none;
    }

    .form-error.show {
        display: block;
    }

    .submit-section {
        background: var(--bg-light);
        padding: 30px;
        border-radius: 16px;
        margin-top: 40px;
        text-align: center;
    }

    .btn-submit {
        background: var(--primary-orange);
        color: white;
        padding: 18px 40px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-md);
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 200px;
        justify-content: center;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }

    .btn-submit:disabled {
        background: var(--text-gray);
        cursor: not-allowed;
        transform: none;
    }

    .btn-cancel {
        background: white;
        color: var(--text-gray);
        border: 2px solid var(--border-color);
        padding: 16px 32px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 500;
        margin-right: 15px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        border-color: var(--primary-blue);
        color: var(--primary-blue);
        text-decoration: none;
    }

    .loading-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid transparent;
        border-top: 2px solid currentColor;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        display: none;
    }

    .loading-spinner.show {
        display: inline-block;
    }

    .job-meta-info {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 20px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--border-color);
        font-size: 0.95rem;
    }

    .meta-icon {
        width: 18px;
        height: 18px;
        color: #5d0909ff;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .alert {
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 1px solid;
        display: none;
    }

    .alert.show {
        display: block;
    }

    .alert-success {
        background-color: #f0fdf4;
        border-color: #bbf7d0;
        color: #166534;
    }

    .alert-error {
        background-color: #fef2f2;
        border-color: #fecaca;
        color: #dc2626;
    }

    .breadcrumb {
        background: white;
        padding: 20px 0;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 0;
    }

    .breadcrumb-list {
        display: flex;
        align-items: center;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .breadcrumb-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .breadcrumb-link {
        color: var(--text-gray);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb-link:hover {
        color: var(--primary-blue);
    }

    .breadcrumb-separator {
        color: var(--border-color);
    }

    .privacy-notice {
        background: #FBF9F4;
        padding: 20px;
        border-radius: 4px;
        border-left: 3px solid var(--primary-blue);
        margin-bottom: 30px;
        font-size: 0.9rem;
        color: var(--text-gray);
        line-height: 1.6;
    }

    .privacy-notice h4 {
        color: var(--text-dark);
        margin-bottom: 10px;
        font-size: 1rem;
    }

    /* Add this CSS inside your section */
    .iti {
        width: 100%;
    }

    .iti__flag-container {
        padding: 14px 12px;
    }

    .iti__selected-flag {
        padding: 14px 12px;
        border-right: 1px solid var(--border-color);
    }

    .iti__country-list {
        border: 2px solid var(--border-color);
        border-radius: 12px;
        box-shadow: var(--shadow-lg);
        max-height: 200px;
        overflow-y: auto;
    }

    .iti__country {
        padding: 10px 15px;
        border-bottom: 1px solid #f0f0f0;
    }

    .iti__country:hover {
        background-color: var(--bg-light);
    }

    .iti__selected {
        background-color: var(--primary-blue);
        color: white;
    }

    .phone-input-container {
        position: relative;
    }

    .phone-input-container .form-input {
        padding-left: 100px; /* Make space for country selector */
    }

    /* Verification Checkbox Styles */
    .verification-section {
        background: #FBF9F4;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        margin-bottom: 30px;
    }

    .checkbox-group {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 0;
    }

    .custom-checkbox {
        position: relative;
        display: flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
        line-height: 1.5;
        font-size: 0.95rem;
        color: var(--text-dark);
    }

    .custom-checkbox input[type="checkbox"] {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }

    .checkmark {
        height: 20px;
        width: 20px;
        background-color: #ffffff;
        border: 2px solid var(--border-color);
        border-radius: 4px;
        margin-right: 12px;
        flex-shrink: 0;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .custom-checkbox:hover input ~ .checkmark {
        border-color: var(--primary-blue);
        background-color: #E8EFF4;
    }

    .custom-checkbox input:checked ~ .checkmark {
        background-color: var(--primary-blue);
        border-color: var(--primary-blue);
    }

    .custom-checkbox input:checked ~ .checkmark:after {
        content: "";
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
        margin-top: -2px;
    }

    .checkbox-error {
        border-color: var(--error-color) !important;
        background-color: #fef2f2 !important;
    }

    .verification-text {
        font-size: 0.9rem;
        color: var(--text-gray);
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .form-container {
            padding: 25px;
            margin: 0 15px;
        }

        .application-title h1 {
            font-size: 2rem;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }
        
        .job-meta-info {
            flex-direction: column;
            gap: 10px;
        }

        .job-summary-meta {
            flex-direction: column;
            gap: 10px;
        }

        .submit-section {
            padding: 20px;
        }

        .btn-cancel {
            margin-right: 0;
            margin-bottom: 15px;
            width: 100%;
            justify-content: center;
        }

        .btn-submit {
            width: 100%;
        }
    }

    @media (max-width: 480px) {
        .application-container {
            padding: 20px 0;
        }

        .application-title h1 {
            font-size: 1.7rem;
        }

        .form-container {
            padding: 20px;
        }

        .job-summary-card {
            padding: 20px;
        }
    }
</style>
{% endblock %}
{% block content %}
<!-- Header Section -->
{% include "partials/header.njk" %}

<!-- Breadcrumb -->
<div class="breadcrumb">
    <div class="container">
        <ul class="breadcrumb-list">
            <li class="breadcrumb-item">
                <a href="/" class="breadcrumb-link">Jobs</a>
                <span class="breadcrumb-separator">›</span>
            </li>
            <li class="breadcrumb-item">
                <a href="{{ (job | jobUrl) }}" class="breadcrumb-link">{{ job.job_title }}</a>
                <span class="breadcrumb-separator">›</span>
            </li>
            <li class="breadcrumb-item">
                <span>Apply</span>
            </li>
        </ul>
    </div>
</div>

<div class="application-container">
    <!-- Application Header -->
    <div class="application-header">
        <div class="container">
            <div class="application-title">
                <h1>Apply for Position</h1>
                <p class="application-subtitle">Submit your application and take the next step in your career</p>
            </div>

            <!-- Job Summary Card -->
            <div class="job-summary-card">
                <div class="job-summary-title">{{ job.job_title }}</div>
                <div class="job-summary-company">{% if job.company_id  and  job.company_name %}<a href="{{ (job | companyUrl) }}" class="company-link">{{ job.company_name }}</a>{% else %} {{ job.company_name  or  'Company Name' }} {% endif %}</div>
                <div class="job-meta-info">
                        <div class="meta-item">
                            <svg class="meta-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            <span>{{ job.city_name  or  job.country_name  or  'Sri Lanka' }}</span>
                        </div>

                        <div class="meta-item">
                            <svg class="meta-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 01-2 2H10a2 2 0 01-2-2V6m8 0H8"/>
                            </svg>
                            <span>{{ job.jobtype  or  'N/A' }}</span>
                        </div>

                        <div class="meta-item">
                            <svg class="meta-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>Posted Date {{ ((job.job_adv_livedate | diffForHumans) if job.job_adv_livedate else "Recently") }}</span>
                        </div>

                        {% if job.days_until_closing != null %}
                            <div class="meta-item">
                                <svg class="meta-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span>
                                    {% if job.days_until_closing > 0 %}
                                        {{ job.days_until_closing }} days left to apply
                                    {% else %}
                                        Application deadline passed
                                    {% endif %}
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    
                    <div class="mobile-apply-btn-wrapper">
                        <span class="btn-mobile-apply-pulse">
                            <button type="button" class="btn-mobile-apply" id="mobileApplyBtn">
                                <svg class="arrow-down" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0l-5-5m5 5l5-5"/>
                                </svg>
                                Apply Now
                                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </button>
                        </span>
                    </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="form-container" id="applicationFormSection">
            <!-- Alert Messages -->
            <div id="alert-success" class="alert alert-success">
                <strong>Success!</strong> <span id="success-message"></span>
            </div>
            <div id="alert-error" class="alert alert-error">
                <strong>Error!</strong> <span id="error-message"></span>
            </div>

            <!-- Privacy Notice -->
            <div class="privacy-notice">
                <h4>🔒 Privacy & Data Protection</h4>
                <p>Your personal information will be used solely for recruitment purposes. We are committed to protecting your privacy and handling your data in accordance with applicable data protection laws.</p>
            </div>

            <!-- Application Form -->
            <form id="applicationForm" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="prototype-csrf-token">
                <input type="hidden" name="job_id" value="{{ job.job_id }}">

                <!-- Personal Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="form-section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        Personal Information
                    </h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label required" for="candidate_title">Title</label>
                            <select name="candidate_title" id="candidate_title" class="form-input form-select" required>
                                <option value="">Select Title</option>
                                <option value="Mr">Mr</option>

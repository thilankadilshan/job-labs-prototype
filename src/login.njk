---
permalink: "/login/"
---
{% extends "layouts/mini-modern.njk" %}
{% block title %}Sign In{% endblock %}
{% block styles %}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
    }

    .fullscreen-auth-container {
        display: flex;
        min-height: 100vh;
        width: 100%;
        position: relative;
    }

    /* Left Section - Hero Image with Content */
    .auth-hero-section {
        flex: 1;
        background: linear-gradient(135deg, rgba(169, 32, 55, 0.77) 0%, rgba(120, 22, 38, 0.81) 100%),
                    url('/assets/front/images/career-success-key.jpg') center/cover;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 4rem 6rem;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .auth-hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
        animation: pulse 15s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.5; }
        50% { transform: scale(1.1) rotate(180deg); opacity: 0.8; }
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
    }

    .hero-logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 3rem;
        font-size: 1.5rem;
        font-weight: 300;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .hero-logo svg {
        width: 32px;
        height: 32px;
        fill: white;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: -1px;
        animation: slideInLeft 1s ease-out;
    }

    .hero-subtitle {
        font-size: 1.5rem;
        font-weight: 400;
        margin-bottom: 1.5rem;
        line-height: 1.4;
        opacity: 0.95;
        animation: slideInLeft 1.2s ease-out;
    }

    .hero-description {
        font-size: 1rem;
        line-height: 1.6;
        opacity: 0.9;
        max-width: 500px;
        animation: slideInLeft 1.4s ease-out;
    }

    .hero-subtitle2 {
        font-size: 1.3rem;
        font-weight: 700;
        /* Bold to make it stand out */
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-top: 3rem;
        /* Add space above it */
        animation: slideInLeft 1.6s ease-out;
        /* Staggered animation */
    }

    .hero-description2 {
        font-size: 0.95rem;
        line-height: 1.5;
        opacity: 0.9;
        max-width: 450px;
        margin-top: 0.5rem;
        /* Small space between subtitle2 and this */
        animation: slideInLeft 1.8s ease-out;
        /* Staggered animation */
    }

    @keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-50px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Right Section - Login Form */
    .auth-form-section {
        flex: 0 0 480px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        position: relative;
    }

    .auth-form-container {
        width: 100%;
        max-width: 400px;
        animation: slideInRight 1s ease-out;
    }

    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(50px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .form-logo {
        text-align: center;
        margin-bottom: 2rem;
    }

    .form-logo img {
        max-height: 60px;
        width: auto;
    }

    .login-form {
        background: white;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .form-input-wrapper {
        position: relative;
    }

    .form-input {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: white;
        color: #333;
    }

    .form-input:focus {
        outline: none;
        border-color: #A92036;
        box-shadow: 0 0 0 3px rgba(169, 32, 54, 0.1);
    }

    .form-input.error {
        border-color: #dc3545;
    }

    .error-message {
        color: #dc3545;
        font-size: 0.813rem;
        margin-top: 0.375rem;
        display: block;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .forgot-password {
        color: #A92036;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: opacity 0.3s ease;
    }

    .forgot-password:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    .submit-btn {
        width: 100%;
        padding: 1rem;
        background: #A92036;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .submit-btn:hover {
        background: #8a1a2d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(169, 32, 54, 0.3);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .submit-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
        color: #999;
        font-size: 0.875rem;
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #ddd;
    }

    .divider span {
        padding: 0 1rem;
    }

    .signup-link {
        text-align: center;
        margin-top: 1.5rem;
        color: #666;
        font-size: 0.875rem;
    }

    .signup-link a {
        color: #A92036;
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.3s ease;
    }

    .signup-link a:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .auth-hero-section {
            padding: 3rem 4rem;
        }

        .hero-title {
            font-size: 3rem;
        }

        .hero-subtitle {
            font-size: 1.25rem;
        }

        .auth-form-section {
            flex: 0 0 420px;
        }
    }

    @media (max-width: 768px) {
        .fullscreen-auth-container {
            flex-direction: column;
        }

        .auth-hero-section {
            min-height: 40vh;
            padding: 2rem;
            align-items: center;
            text-align: center;
        }

        .hero-content {
            max-width: 100%;
        }

        .hero-title {
            font-size: 2.5rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
        }

        .hero-description {
            font-size: 0.95rem;
        }

        .auth-form-section {
            flex: 1;
            padding: 2rem 1.5rem;
        }

        .login-form {
            padding: 2rem 1.5rem;
        }
    }

    @media (max-width: 480px) {
        .auth-hero-section {
            min-height: 35vh;
            padding: 1.5rem;
        }

        .hero-logo {
            margin-bottom: 2rem;
            font-size: 1.2rem;
        }

        .hero-title {
            font-size: 2rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }

        .hero-description {
            font-size: 0.875rem;
        }

        .auth-form-section {
            padding: 1.5rem 1rem;
        }

        .login-form {
            padding: 1.5rem;
        }

        .form-input {
            padding: 0.75rem;
        }

        .submit-btn {
            padding: 0.875rem;
        }
    }

    /* Loading State */
    .btn-loading {
        position: relative;
        color: transparent;
        pointer-events: none;
    }

    .btn-loading::after {
        content: '';
        position: absolute;
        width: 20px;
        height: 20px;
        top: 50%;
        left: 50%;
        margin-left: -10px;
        margin-top: -10px;
        border: 2px solid transparent;
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
{% endblock %}
{% block content %}
<div class="fullscreen-auth-container">
    <!-- Left Section - Hero -->
    <div class="auth-hero-section">
        <div class="hero-content">
            <div class="hero-logo">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" 
                    fill="currentColor" width="40" height="40">
                    <path d="M12 2L13.09 8.26L19 9.27L14.5 13.14L15.82 19L12 15.77L8.18 19L9.5 13.14L5 9.27L10.91 8.26L12 2Z"/>
                </svg>
                <span>TALENT</span>
            </div>
            <h1 class="hero-title">CRAFT YOUR<br>TEAMS</h1>
            <p class="hero-subtitle">Find exceptional talent that matches your vision.</p>
            <p class="hero-description">
                Streamline recruitment and connect with the people who will drive your success - your next great hire is just a click away. </p>
            <p class="hero-subtitle2">SIGN IN.</p>
            <p class="hero-description2">Build, grow, and connect with top talent faster..</p>

        </div>
    </div>

    <!-- Right Section - Login Form -->
    <div class="auth-form-section">
        <div class="auth-form-container">
            <div class="form-logo">
                <img src="/assets/front/images/hr/job_logo.png" alt="Job Labs Logo">
            </div>

            <div class="login-form">
                <form method="POST" action="/ats" id="loginForm">
                    <input type="hidden" name="_token" value="prototype-csrf-token">

                    <!-- Email Field -->
                    <div class="form-group">
                        <label for="email" class="form-label">Email</label>
                        <div class="form-input-wrapper">
                            <input 
                                id="email" 
                                type="email" 
                                class="form-input {% if false %} error {% endif %}" 
                                name="email" 
                                value="" 
                                required 
                                autocomplete="email" 
                                autofocus 
                                placeholder="Enter your email"
                            >
                            {% if false %}
                                <span class="error-message">{{ message }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="form-group">
                        <label for="password" class="form-label">Password</label>
                        <div class="form-input-wrapper">
                            <input 
                                id="password" 
                                type="password" 
                                class="form-input {% if false %} error {% endif %}" 
                                name="password" 
                                required 
                                autocomplete="current-password"
                                placeholder="Enter your password"
                            >
                            {% if false %}
                                <span class="error-message">{{ message }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Forgot Password -->
                    <!-- <div class="form-footer">
                        {% if true %}
                            <a href="/password/reset" class="forgot-password">
                                Forgot password?
                            </a>
                        {% endif %}
                    </div> -->

                    <!-- Submit Button -->
                    <button type="submit" class="submit-btn" id="submitBtn">
                        Sign In
                    </button>

                    <!-- Divider -->
                    <div class="divider">
                        <span>or</span>
                    </div>

                    <!-- Register Link -->
                    {% if true %}
                    <div class="signup-link">
                        Are you new? <a href="/recruiters-signup">Create an Account</a><br/>
                        <a href="/employer">Back to Employer Details</a>
                    </div>
                    {% endif %}
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('loginForm');
    const submitBtn = document.getElementById('submitBtn');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');

    // Email validation
    emailInput.addEventListener('blur', function() {
        const email = this.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        
        if (email && !emailRegex.test(email)) {
            this.classList.add('error');
        } else {
            this.classList.remove('error');
        }
    });

    // Remove error class on input
    [emailInput, passwordInput].forEach(input => {
        input.addEventListener('input', function() {
            this.classList.remove('error');
            const errorMsg = this.parentElement.querySelector('.error-message');
            if (errorMsg && !errorMsg.textContent.includes('{{ "{{" }}')) {
                errorMsg.remove();
            }
        });
    });

    // Form submission
    form.addEventListener('submit', function(e) {
        // Add loading state
        submitBtn.classList.add('btn-loading');
        submitBtn.disabled = true;

        // If there are validation errors, re-enable the button
        setTimeout(() => {
            if (document.querySelector('.error-message')) {
                submitBtn.classList.remove('btn-loading');
                submitBtn.disabled = false;
            }
        }, 100);
    });

    // Add smooth focus effects
    const inputs = document.querySelectorAll('.form-input');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.parentElement.style.transform = 'translateY(-2px)';
        });
        
        input.addEventListener('blur', function() {
            this.parentElement.style.transform = 'translateY(0)';
        });
    });
});
</script>
{% endblock %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('scrollingTrack');
    const leftBtn = document.getElementById('scrollLeft');
    const rightBtn = document.getElementById('scrollRight');
    const dotsContainer = document.getElementById('paginationDots');
    
    if (!track || !leftBtn || !rightBtn) return;
    
    let totalCards = track.children.length;
    let currentIndex = 0; 

    // ---- Sort by: Default / Featured / Urgent ----
    const sortSelect = document.getElementById('sliderSortSelect');
    const emptyMsg = document.getElementById('sliderEmpty');
    const defaultCardsHtml = track.innerHTML;
    const emptyText = {
        featured: 'No featured jobs right now. Check back soon!',
        urgent: 'No urgent jobs right now. Check back soon!'
    };
    if (sortSelect) {
        sortSelect.addEventListener('change', function () {
            const value = this.value;
            const tpl = document.getElementById('sliderSet-' + value);
            track.innerHTML = (value === 'default' || !tpl) ? defaultCardsHtml : tpl.innerHTML;
            totalCards = track.children.length;
            currentIndex = 0;
            if (emptyMsg) {
                emptyMsg.hidden = totalCards > 0;
                emptyMsg.textContent = totalCards > 0 ? '' : (emptyText[value] || 'No jobs to show.');
            }
            track.style.transition = 'none';
            updateCarousel();
            requestAnimationFrame(() => { track.style.transition = ''; });
        });
    }
    
    
    function getCardsToShow() {
        if (window.innerWidth <= 768) return 1;
        if (window.innerWidth <= 992) return 2;
        return 4;
    }
    
    function updateCarousel() {
        const cardsToShow = getCardsToShow();
        const maxIndex = Math.max(0, totalCards - cardsToShow);
        
        if (currentIndex > maxIndex) currentIndex = maxIndex;
        if (currentIndex < 0) currentIndex = 0;
        
        const card = track.children[0];
        if (!card) {
            track.style.transform = 'translateX(0)';
            leftBtn.disabled = true;
            rightBtn.disabled = true;
            if (dotsContainer) dotsContainer.innerHTML = '';
            return;
        }
        const gap = 25; 
        const cardWidth = card.offsetWidth;
        
        const moveAmount = currentIndex * (cardWidth + gap);
        track.style.transform = `translateX(-${moveAmount}px)`;
        
        leftBtn.disabled = currentIndex === 0;
        rightBtn.disabled = currentIndex >= maxIndex;
        
        generateDots(cardsToShow, maxIndex);
    }
    
    function generateDots(cardsToShow, maxIndex) {
        if (!dotsContainer) return;
        dotsContainer.innerHTML = '';
        
        const numPages = Math.ceil(totalCards / cardsToShow);
        let currentPage = Math.ceil(currentIndex / cardsToShow);
        
        if (currentIndex === maxIndex && maxIndex > 0) {
            currentPage = numPages - 1;
        }
        
        if (numPages > 1) {
            for (let i = 0; i < numPages; i++) {
                const dot = document.createElement('div');
                dot.className = 'dot';
                if (i === currentPage) dot.classList.add('active');
                
                dot.addEventListener('click', () => {
                    currentIndex = Math.min(i * cardsToShow, maxIndex);
                    updateCarousel();
                });
                
                dotsContainer.appendChild(dot);
            }
        }
    }
    
    leftBtn.addEventListener('click', () => {
        const cardsToShow = getCardsToShow();
        currentIndex -= cardsToShow;
        updateCarousel();
    });
    
    rightBtn.addEventListener('click', () => {
        const cardsToShow = getCardsToShow();
        currentIndex += cardsToShow;
        updateCarousel();
    });
    
    window.addEventListener('resize', updateCarousel);
    setTimeout(updateCarousel, 50);

    let startX = 0;
    let isDragging = false;
    const scrollingContainer = document.querySelector('.scrolling-container');
    
    if (scrollingContainer) {
        scrollingContainer.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            isDragging = true;
        }, {passive: true});
        
        scrollingContainer.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
        }, {passive: true});
        
        scrollingContainer.addEventListener('touchend', (e) => {
            if (!isDragging) return;
            const endX = e.changedTouches[0].clientX;
            const diffX = startX - endX;
            const cardsToShow = getCardsToShow();
            
            if (Math.abs(diffX) > 50) {
                if (diffX > 0) {
                    currentIndex += cardsToShow; 
                } else {
                    currentIndex -= cardsToShow; 
                }
                updateCarousel();
            }
            isDragging = false;
        });
    }
});
</script>

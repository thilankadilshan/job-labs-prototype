                <div class="job-card" data-job-id="{{ job.job_id }}" data-job-type="{{ job.job_adv_jobtype }}" data-job-sector="{{ job.job_adv_jobsector }}" data-work-type="{{ job.job_adv_worktype }}" data-industry-sector="{{ job.job_industrysector }}" data-city="{{ job.city_id }}" data-salary="{{ job.job_adv_salary }}" data-search="{{ (job.job_title ~ ' ' ~ (job.job_adv_description | plainText) ~ ' ' ~ (job.job_adv_keyword | plainText)) | lower }}">
                    <div class="job-header">
                        <div>
                            <h3 class="job-title">{{ job.job_title }}</h3>
                            <p class="job-company">{% if job.company_id  and  job.company_name %}<a href="{{ (job | companyUrl) }}" class="company-link">{{ job.company_name }}</a>{% else %} {{ job.company_name  or  'Company Name' }} {% endif %}</p>
                        </div>
                        <div>
                            {% if job.job_adv_top_rated == '1' %}
                            <span class="job-status status-top-rated">
                                <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />

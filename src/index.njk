<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterForm = document.getElementById('jobFilterForm');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const horizontalSection = document.getElementById('horizontalVacanciesSection');

        if (!filterForm) return;

        // Show loading overlay on submit
        if (loadingOverlay) {
            filterForm.addEventListener('submit', function() {
                loadingOverlay.classList.add('active');
            });
        }

        // Auto-submit on select change (optional)
        const selectElements = filterForm.querySelectorAll('select');
        selectElements.forEach(select => {
            select.addEventListener('change', function() {
                // filterForm.submit();
            });
        });

        // Job card animations
        const jobCards = document.querySelectorAll('.job-card');
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        jobCards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            card.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
            observer.observe(card);
        });

        // Toggle horizontal section based on filters
        function toggleHorizontalSection() {
            if (!horizontalSection) return;

            const formData = new FormData(filterForm);
            let hasFilters = false;

            for (let [key, value] of formData.entries()) {
                if (value && value.trim() !== '' && key !== '_token') {
                    hasFilters = true;
                    break;
                }
            }

            horizontalSection.style.display = hasFilters ? 'none' : 'block';
        }

        toggleHorizontalSection();

        const filterInputs = filterForm.querySelectorAll('select, input[type="text"]');
        filterInputs.forEach(input => {
            input.addEventListener('change', toggleHorizontalSection);
            input.addEventListener('input', toggleHorizontalSection);
        });
    });
</script>


<script>
    // ==================== Custom pagination ====================
    // Renders its own markup/classes entirely client-side from data
    // attributes — no dependency on Laravel's ->links() view or any CSS
    // framework, so styling can never silently fail to apply again.
    document.addEventListener('DOMContentLoaded', function () {
        const ICON_PREV = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>';
        const ICON_NEXT = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>';

        function urlForPage(sampleUrl, page) {
            const url = new URL(sampleUrl, window.location.origin);
            url.searchParams.set('page', page);
            return url.toString();
        }

        // Builds [1, '…', 4, 5, 6, '…', 20] style page lists — full range
        // when small, truncated with ellipses around the current page
        // when there are many pages.
        function buildPageList(current, last) {
            const delta = 1;
            const range = [];
            const withDots = [];
            let previous;

            for (let i = 1; i <= last; i++) {
                if (i === 1 || i === last || (i >= current - delta && i <= current + delta)) {
                    range.push(i);
                }
            }

            range.forEach(function (i) {
                if (previous) {
                    if (i - previous === 2) {
                        withDots.push(previous + 1);
                    } else if (i - previous !== 1) {
                        withDots.push('...');
                    }
                }
                withDots.push(i);
                previous = i;
            });

            return withDots;
        }

        function renderPagination(container) {
            const current = parseInt(container.dataset.currentPage, 10);
            const last = parseInt(container.dataset.lastPage, 10);
            const sampleUrl = container.dataset.pageUrl;

            if (!sampleUrl || !last || last <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = '<nav class="cp-nav" aria-label="Pagination"><ul class="cp-list">';

            // Previous
            if (current === 1) {
                html += '<li class="cp-item"><span class="cp-link cp-disabled" aria-disabled="true">' + ICON_PREV + '</span></li>';
            } else {
                html += '<li class="cp-item"><a class="cp-link" href="' + urlForPage(sampleUrl, current - 1) + '" rel="prev" aria-label="Previous page">' + ICON_PREV + '</a></li>';
            }

            // Page numbers (with ellipsis for large ranges)
            buildPageList(current, last).forEach(function (page) {
                if (page === '...') {
                    html += '<li class="cp-item"><span class="cp-ellipsis">&hellip;</span></li>';
                } else if (page === current) {
                    html += '<li class="cp-item"><span class="cp-link cp-active" aria-current="page">' + page + '</span></li>';
                } else {
                    html += '<li class="cp-item"><a class="cp-link" href="' + urlForPage(sampleUrl, page) + '">' + page + '</a></li>';
                }
            });

            // Next
            if (current === last) {
                html += '<li class="cp-item"><span class="cp-link cp-disabled" aria-disabled="true">' + ICON_NEXT + '</span></li>';
            } else {
                html += '<li class="cp-item"><a class="cp-link" href="' + urlForPage(sampleUrl, current + 1) + '" rel="next" aria-label="Next page">' + ICON_NEXT + '</a></li>';
            }

            html += '</ul></nav>';
            container.innerHTML = html;
        }

        document.querySelectorAll('.custom-pagination').forEach(renderPagination);
    });
</script>

{% endblock %}

---
permalink: "/"
---
{% extends "layouts/master.njk" %}
{% block title %}Find Jobs in Sri Lanka | Job Labs{% endblock %}
{% block description %}Explore the latest job vacancies in Sri Lanka. Filter jobs by sector, type, and work preferences to find your ideal opportunity.{% endblock %}
{% block keywords %}jobs in sri lanka, job vacancies, job search sri lanka, job labs careers{% endblock %}
{% block og_title %}Find Jobs in Sri Lanka | Job Labs{% endblock %}
{% block og_description %}Explore the latest job vacancies in Sri Lanka. Filter jobs by sector, type, and work preferences to find your ideal opportunity.{% endblock %}
{% block styles %}
<style>
    :root {
        --primary-blue: #2563eb;
        --primary-orange: #A92036;
        --dark-blue: #1e40af;
        --text-dark: #1f2937;
        --text-gray: #6b7280;
        --border-color: #e5e7eb;
        --bg-light: #f8fafc;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    }

    .job-board-container {
        min-height: 50vh;
        padding: 40px 0;
        z-index: 2;
    }

    .job-board-header {
        text-align: center;
        margin-bottom: 50px;
        padding: 40px 20px 20px;
        position: relative;
        z-index: 2;
    }

    .header-background-container {
        position: relative;
        background-image: url("/assets/front/images/hero-03.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }


    .header-background-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(37, 99, 235, 0.1);
        z-index: 1;
    }

    .job-board-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 15px;
        background: #ffffffff;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .job-board-subtitle {
        font-size: 1.2rem;
        /* color: var(--text-gray); */
        color: #ffffff;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .filters-container {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: var(--shadow-md);
        margin-bottom: 40px;
        border: 1px solid var(--border-color);
        position: relative;
        z-index: 3;
        margin-top: -120px;
    }

    .filters-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-label {
        font-weight: 500;
        color: var(--text-dark);
        font-size: 0.95rem;
    }

    .filter-select,
    .filter-input {
        padding: 12px 16px;
        border: 2px solid var(--border-color);
        border-radius: 10px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: white;
        color: var(--text-dark);
    }

    .filter-select:focus,
    .filter-input:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .filter-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 0.95rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-blue), var(--dark-blue));
        color: white;
        box-shadow: var(--shadow-md);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
    }

    .btn-secondary {
        background: white;
        color: var(--text-gray);
        border: 2px solid var(--border-color);
    }

    .btn-secondary:hover {
        background: var(--bg-light);
        border-color: var(--primary-blue);
        color: var(--primary-blue);
    }

    .jobs-container {
        display: grid;
        gap: 25px;
    }

    .job-card {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .job-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(135deg, var(--primary-blue), var(--primary-orange));
        transform: scaleY(0);
        transition: transform 0.3s ease;
    }

    .job-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
        border-color: var(--primary-blue);
    }

    .job-card:hover::before {
        transform: scaleY(1);
    }

    .job-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        gap: 20px;
    }

    .job-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .job-company {
        color: var(--primary-blue);
        font-weight: 500;
        font-size: 1.1rem;
    }

    .job-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-top-rated {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: white;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 10px;
    }

    /* Badge group (Featured / Urgent / Live) on job cards: evenly spaced */
    .job-header > div:last-child {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        align-content: flex-start;
        gap: 8px;
        max-width: 260px;
    }
    .job-header > div:last-child .job-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin: 0;
        line-height: 1.4;
        white-space: nowrap;
        border: 1px solid transparent;
    }
    .status-urgent {
        background: #fff4ec;
        color: #c2410c;
        border-color: #fdba74 !important;
    }

    .job-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .job-detail-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-gray);
        font-size: 0.9rem;
    }

    .job-detail-icon {
        width: 18px;
        height: 18px;
        color: var(--primary-orange);
        flex-shrink: 0;
    }

    .job-description {
        color: var(--text-gray);
        line-height: 1.6;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .job-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
    }

    .job-tag {
        padding: 4px 12px;
        background: var(--bg-light);
        color: var(--text-gray);
        border-radius: 15px;
        font-size: 0.8rem;
        border: 1px solid var(--border-color);
    }

    .job-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid var(--border-color);
        gap: 15px;
    }

    .job-salary {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--primary-blue);
    }

    .job-dates {
        font-size: 0.85rem;
        color: var(--text-gray);
        text-align: right;
    }

    .btn-apply {
        background: #A92036;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-apply:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .no-jobs {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-gray);
    }

    .no-jobs-icon {
        font-size: 4rem;
        color: var(--border-color);
        margin-bottom: 20px;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 40px;
        margin-bottom: 60px;
    }

    /* ==================== Custom pagination (no Laravel ->links(), no
       Bootstrap dependency) — fully own markup + classes, rendered by JS
       from data attributes so it can never collide with any other CSS. ==== */
    .cp-nav {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .cp-list {
        display: flex;
        align-items: center;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        justify-content: center;
    }

    .cp-item {
        display: flex;
    }

    .cp-link {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 42px;
        padding: 0 14px;
        border-radius: 10px;
        border: 2px solid var(--border-color);
        background: white;
        color: var(--text-gray);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        user-select: none;
    }

    .cp-link:hover:not(.cp-disabled):not(.cp-active) {
        background: var(--bg-light);
        border-color: var(--primary-blue);
        color: var(--primary-blue);
    }

    .cp-link:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .cp-link.cp-active {
        background: linear-gradient(135deg, var(--primary-blue), var(--primary-orange));
        border-color: transparent;
        color: white;
        box-shadow: var(--shadow-md);
        cursor: default;
    }

    .cp-link.cp-disabled {
        opacity: 0.4;
        cursor: not-allowed;
        background: var(--bg-light);
        pointer-events: none;
    }

    .cp-link svg {
        width: 16px;
        height: 16px;
    }

    .cp-ellipsis {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 42px;
        color: var(--text-gray);
        font-weight: 600;
        letter-spacing: 1px;
    }

    @media (max-width: 480px) {
        .cp-link,
        .cp-ellipsis {
            min-width: 36px;
            height: 36px;
            padding: 0 8px;
            font-size: 0.8rem;
        }
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .loading-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid var(--border-color);
        border-top: 4px solid var(--primary-blue);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    /*  */
    .job-board-tagline {
        font-size: 1.1rem;
        color: #ffffff;
        margin-bottom: 10px;
        font-weight: 500;
    }

    .job-board-quote {
        font-size: 1.3rem;
        color: #ffffff;
        font-weight: 600;
        font-style: italic;
        margin-bottom: 20px;
    }

    .hero-action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    .btn-hero {
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        font-size: 1rem;
        min-width: 140px;
        justify-content: center;
    }

    .btn-hero-primary {
        background: linear-gradient(135deg, var(--primary-orange), #ea580c);
        color: white;
        box-shadow: var(--shadow-md);
    }

    .btn-hero-primary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }

    .btn-hero-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
    }

    .btn-hero-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-2px);
    }

    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Responsive Design */
    @media (max-width: 768px) {

        .hero-action-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-hero {
            width: 100%;
            max-width: 280px;
        }

        .job-board-tagline {
            font-size: 1rem;
        }

        .job-board-quote {
            font-size: 1.1rem;
        }

        .job-board-title {
            font-size: 2rem;
        }

        .job-board-header {
            padding: 60px 20px 30px;
        }

        .filters-container {
            margin-top: -80px;
        }

        .header-background-container {
            background-attachment: scroll;
            /* Better for mobile */
        }

        /* .filters-container {
            padding: 20px;
        } */

        .filters-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .job-card {
            padding: 20px;
        }

        .job-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .job-header > div:last-child {
            justify-content: flex-start;
            max-width: none;
        }

        .job-details {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .job-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .job-dates {
            text-align: left;
        }

        .filter-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .job-board-container {
            padding: 20px 0;
        }

        .job-board-tagline {
            font-size: 0.9rem;
        }

        .job-board-quote {
            font-size: 1rem;
        }

        /* .job-board-header {
            margin-bottom: 30px;
        } */

        .job-board-title {
            font-size: 1.8rem;
        }

        .job-board-subtitle {
            font-size: 1rem;
        }

        .job-board-header {
            padding: 40px 20px 20px;
        }

        .filters-container {
            margin-top: -60px;
        }

    }

    /* Landing page header customizations */
    .main-header {
        background-color: #f7f7f7 !important;
        border-bottom: none;
        padding-top: 11px;
    }

    /* --- New Styles for Search Results Layout --- */
    .search-results-wrapper {
        display: grid;
        grid-template-columns: 300px 1fr;
        /* Sidebar width and main content */
        gap: 30px;
        align-items: flex-start;
        margin-top: 40px;
    }

    .advanced-filters-sidebar {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-color);
        position: sticky;
        /* Makes the sidebar follow you on scroll */
        top: 20px;
        /* Space from the top when sticky */
    }


    /* Override filter grid for a single column layout inside the sidebar */
    .advanced-filters-sidebar .filters-grid {
        grid-template-columns: 1fr;
        gap: 15px;
    }

    /* Stack filter buttons vertically in the sidebar */
    .advanced-filters-sidebar .filter-actions {
        flex-direction: column;
    }

    .advanced-filters-sidebar .filter-select,
    .advanced-filters-sidebar .filter-input {
        width: 100%;
        box-sizing: border-box;
        /* This is important! It includes padding/border in the total width */
    }

    .advanced-filters-sidebar .btn {
        width: 100%;
        justify-content: center;
    }

    .jobs-results-content h4 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 20px;
        color: var(--text-dark);
    }

    /* --- End of New Styles --- */

    /* Responsive Design */
    @media (max-width: 992px) {

        /* Add this new media query */
        .search-results-wrapper {
            grid-template-columns: 1fr;
            /* Stack the columns on tablets */
        }

        .advanced-filters-sidebar {
            position: static;
            /* Disable sticky behavior on smaller screens */
            margin-bottom: 30px;
        }
    }
</style>
{% endblock %}
{% block content %}
<!-- Header Section -->
{% include "partials/header.njk" %}

<section class="hero-section-wrapper">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@200;400;500;700&display=swap');

        @font-face {
            font-family: 'Neue Machina';
            src: url('/fonts/NeueMachina-Regular.otf') format('opentype');
            font-weight: 400;
            font-style: normal;
        }

        @font-face {
            font-family: 'Neue Machina';
            src: url('/fonts/NeueMachina-Bold.otf') format('opentype');
            font-weight: 700;
            font-style: normal;
        }

        .hero-container {
            font-family: 'Inter', sans-serif;
            background-color: #019bd2; 
            background-image: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), url('/images/newhero.jpeg'); 
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 80px 4% 90px;
            min-height: 50vh;
            overflow: hidden;
            position: relative;
        }

        .hero-content {
            width: 100%;
            max-width: 1100px;
            text-align: center;
            z-index: 2;
        }

        .hero-content h1 {
            font-family: 'Neue Machina', sans-serif !important;
            font-size: 4rem;
            font-weight: 700;
            color: #ffffff;
            position: relative;
            display: inline-block;
            margin-bottom: 10px;
            opacity: 0;
            animation: fadeInUp 1s ease-out 0.2s forwards;
        }

        .hero-content p {
            font-size: 1.25rem;
            color: #ffffff;
            margin-bottom: 40px; 
            opacity: 0;
            animation: fadeInUp 1s ease-out 0.4s forwards;
        }

        .hero-free-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: -24px auto 28px;
            padding: 7px 16px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.35);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            color: #ffffff;
            font-size: 0.92rem;
            font-weight: 600;
            opacity: 0;
            animation: fadeInUp 1s ease-out 0.5s forwards;
        }
        .hero-free-badge i { color: #4ade80; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- SEARCH BAR DESIGN --- */
        .search-bar {
            display: flex;
            align-items: center;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            padding: 10px;
            width: 100%;
            opacity: 0;
            animation: fadeInUp 1s ease-out 0.6s forwards;
        }

        .search-input {
            border: none;
            outline: none;
            padding: 16px 20px;
            font-size: 1.05rem;
            background: transparent;
            color: #2d3748;
            flex-grow: 1;
            width: 100%;
        }

        .search-input::placeholder {
            color: #a0aec0;
        }

        .search-filters {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .search-filters .search-select {
            border: none;
            outline: none;
            background: transparent;
            color: #2d3748;
            font-size: 1.05rem;
            padding: 16px 25px;
            flex-basis: 180px;
            cursor: pointer;
            border-left: 2px solid #edf2f7; 
        }

        .search-btn {
            background: #A02B4A; 
            color: #ffffff;
            border: none;
            padding: 16px 35px;
            cursor: pointer;
            font-size: 1.05rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 8px;
            transition: background-color 0.3s ease;
            margin-left: 10px;
            flex-shrink: 0;
        }

        .search-btn:hover {
            background: #802038;
        }

        /* RESPONSIVE CSS */
        @media (max-width: 992px) {
            .hero-container {
                padding: 60px 4% 70px;
                min-height: auto;
            }

            .hero-content h1 {
                font-size: 3rem;
                white-space: normal;
            }
        }

        @media (max-width: 768px) {
            .hero-container {
                padding: 30px 4% 40px; 
            }

            .hero-content h1 {
                font-size: 2rem; 
            }

            .hero-content p {
                font-size: 1rem; 
                margin-bottom: 25px; 
            }

            .hero-free-badge {
                margin: -12px auto 18px;
                font-size: 0.78rem;
                padding: 6px 12px;
                text-align: left;
            }

            .hero-free-more { display: none; }

            .search-bar {
                flex-direction: column;
                background: transparent;

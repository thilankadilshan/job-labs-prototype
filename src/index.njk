<div class="container">

    <template id="protoSearchView">
    
    
    
    <div class="search-results-wrapper">

        <aside class="advanced-filters-sidebar">
            <h2 class="filters-title">
                <svg class="job-detail-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Filter Jobs
            </h2>

            <form id="jobFilterForm" method="GET" action="/">
                <div class="filters-grid">
                    <div class="filter-group">
                        <label class="filter-label">Job Title / Keywords</label>
                        <input type="text" name="search" class="filter-input" placeholder="e.g. Software Engineer..." value="">
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Job Type</label>
                        <select name="job_type" class="filter-select">
                            <option value="">All Job Types</option>
                            {% for type in lookups.jobTypes %}
                            <option value="{{ type.label_id }}" {{ ("selected" if '' == type.label_id else "") }}>
                                {{ type.label_name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Job Sector</label>
                        <select name="job_sector" class="filter-select">
                            <option value="">All Sectors</option>
                            {% for sector in lookups.jobSectors %}
                            <option value="{{ sector.label_id }}" {{ ("selected" if '' == sector.label_id else "") }}>
                                {{ sector.label_name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Work Type</label>
                        <select name="work_type" class="filter-select">
                            <option value="">All Work Types</option>
                            {% for workType in lookups.workTypes %}
                            <option value="{{ workType.label_id }}" {{ ("selected" if '' == workType.label_id else "") }}>
                                {{ workType.label_name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Industry Sector</label>
                        <select name="industry_sector" class="filter-select">
                            <option value="">All Industries</option>
                            {% for industry in lookups.industrySectors %}
                            <option value="{{ industry.label_id }}" {{ ("selected" if '' == industry.label_id else "") }}>
                                {{ industry.label_name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">City</label>
                        <select name="city" class="filter-select">
                            <option value="">All Cities</option>
                            {% for city in lookups.cities %}
                            <option value="{{ city.city_id }}" {{ ("selected" if '' == city.city_id else "") }}>
                                {{ city.city_name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Salary Range</label>
                        <select name="salary_range" class="filter-select">
                            <option value="">Any Salary</option>
                            <option value="0-50000" {{ ("selected" if '' == '0-50000' else "") }}>Up to LKR 50,000</option>
                            <option value="50000-100000" {{ ("selected" if '' == '50000-100000' else "") }}>LKR 50,000 - 100,000</option>
                            <option value="100000-200000" {{ ("selected" if '' == '100000-200000' else "") }}>LKR 100,000 - 200,000</option>
                            <option value="200000+" {{ ("selected" if '' == '200000+' else "") }}>LKR 200,000+</option>
                        </select>
                    </div>
                </div>

                <div class="filter-actions" style="margin-top: 25px;">
                    <button type="submit" class="btn btn-primary">Search Jobs</button>
                    <a href="/" class="btn btn-secondary">Clear Filters</a>
                </div>
            </form>
        </aside>

        <main class="jobs-results-content">
            <h4 class="proto-total">Showing {{ jobs | length }} Job Results</h4>

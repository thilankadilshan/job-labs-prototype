                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 01-2 2H10a2 2 0 01-2-2V6m8 0H8" />
                            </svg>
                            <span>{{ job.jobtype  or  'N/A' }}</span>
                        </div>
                        <div class="job-detail-item">
                            <svg class="job-detail-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                            <span>{{ job.worktype  or  'N/A' }}</span>
                        </div>
                        <div class="job-detail-item">
                            <svg class="job-detail-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                            <span>{{ job.job_adv_total_vacancies }} Position{{ ("s" if job.job_adv_total_vacancies > 1 else "") }}</span>
                        </div>
                    </div>
                    {% if job.job_adv_description %}
                    <div class="job-description">
                        {{ (job.job_adv_description | plainText | limitStr(200)) }}
                    </div>
                    {% endif %}
                    <div class="job-tags">
                        {% if job.jobsector %}
                        <span class="job-tag">{{ job.jobsector }}</span>
                        {% endif %}
                        {% if job.industrysector %}
                        <span class="job-tag">{{ job.industrysector }}</span>
                        {% endif %}
                        {% if job.job_refno %}
                        <span class="job-tag">Ref: {{ job.job_refno }}</span>
                        {% endif %}
                    </div>
                    <div class="job-footer">
                        <div>
                            <div class="job-salary">
                                {{ ('LKR ' ~ job.job_adv_salary if job.job_adv_salary else "Salary Negotiable") }}
                            </div>
                        </div>
                        <div class="job-dates">
                            <div><strong>Closing Date:</strong> {{ ((job.job_adv_closingdate | fmtDate) if job.job_adv_closingdate else "N/A") }}</div>
                        </div>
                        <a href="{{ (job | jobUrl) }}" class="btn-apply">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />

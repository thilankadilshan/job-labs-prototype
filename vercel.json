{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "eleventy",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/jobs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/career-hub",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ats",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-of-service",
      "permanent": false
    }
  ]
}
